<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(RefertoPallamano_Blazor.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(RefertoPallamano_Blazor.Components.Layout.MainLayout)">
            <div class="not-found">Pagina non trovata.</div>
        </LayoutView>
    </NotFound>
</Router>

@using RefertoPallamano_Blazor.Models
@implements IDisposable
@inject GameService Game

<section class="team-panel @(Team == "A" ? "home-panel" : "away-panel")" style="--team-color:@TeamColor;--team-text-color:@TeamTextColor">
    <div class="panel-title team-panel-title">
        <span class="team-title-name">@(Team == "A" ? Game.State.Casa.Name : Game.State.Ospiti.Name)</span>
        <span class="team-counters">
            @if (!Game.State.ShootoutStarted)
            {
                <span>AMM <b>@Game.YellowCountFor(Team)/3</b></span>
            }
            <span>TIME OUT <b>@Game.TimeoutCount(Team)/3</b></span>
            @if (Game.State.TimeoutRemainingSeconds > 0 && Game.State.TimeoutTeam == Team)
            {
                <span class="timeout-countdown">TO @RefertoPallamano_Blazor.Services.GameService.FormatTime(Game.State.TimeoutRemainingSeconds)</span>
            }
            @if (Game.State.ShootoutStarted)
            {
                <span>Rigori: <b>@Game.ShootoutGoalsFor(Team)/@Game.ShootoutAttemptsFor(Team)</b></span>
            }
            else
            {
                <span>7m <b>@Game.PenaltyAttempts(Team)/@Game.PenaltyRealized(Team)</b></span>
            }
        </span>
    </div>
    <div class="player-grid">
        @foreach (var index in OrderedPlayerIndices())
        {
            var roster = Team == "A" ? Game.State.Casa : Game.State.Ospiti;
            var number = roster.NumberLabels is { Length: 16 } ? (roster.NumberLabels[index] ?? string.Empty).Trim() : string.Empty;
            var name = roster.PlayerNames[index];
            var suspensions = Game.GetPlayerSuspensionBadges(Team, number).ToList();
            var yellow = Game.PlayerHasYellow(Team, number);
            var red = Game.PlayerIsInhibited(Team, number);
            @if (Game.State.ShootoutStarted)
            {
                var canShoot = Game.CanShootoutPlayer(Team, index);
                <button type="button" class="player-card shootout-player-card @(!roster.ActivePlayers[index] ? "inactive-player" : "") @(red ? "has-red" : "") @(canShoot ? "shootout-eligible" : "shootout-not-turn")" disabled="@(!canShoot)" aria-label="Giocatore N.@number" @onclick="() => OpenShootout(index)">
                    <span class="number">@number</span>
                    <span class="player-info">
                        <span class="shootout-player-topline">
                            <span class="player-name" title="@(string.IsNullOrWhiteSpace(name) ? "GIOCATORE" : name)">@(string.IsNullOrWhiteSpace(name) ? "GIOCATORE" : name)</span>
                        </span>
                        <span class="player-indicators shootout-stats-row">
                            <span class="stat-item goal-indicator">GOAL @Game.PlayerGoals(Team, number)</span>
                            <span class="stat-item penalty-indicator">RIGORI @Game.ShootoutPlayerGoals(Team, number)/@Game.ShootoutPlayerAttempts(Team, number)</span>
                        </span>
                        <span class="shootout-bottom-stats">
                            <span>A</span><span>2' @Game.PlayerTwoCount(Team, number)/3</span><span>@(red ? "E" : "E")</span>
                        </span>
                        @if (suspensions.Count > 0)
                        {
                            <span class="active-countdown-row">
                                @foreach (var suspension in suspensions)
                                {
                                    <span class="active-countdown @(suspension.IsRed ? "countdown-red" : "countdown-two")">@(suspension.IsRed ? "E" : "2'") @suspension.Remaining</span>
                                }
                            </span>
                        }
                    </span>
                </button>
            }
            else
            {
                <button type="button" disabled="@(!roster.ActivePlayers[index] || red)" aria-label="Giocatore N.@number @(string.IsNullOrWhiteSpace(name) ? "senza nome" : name)" class="player-card @(!roster.ActivePlayers[index] ? "inactive-player" : "") @(red ? "has-red" : "") @(Game.PendingEvent is not null && roster.ActivePlayers[index] ? "touch-ready" : "")" @onclick="() => SelectPlayer(index)">
                    <span class="number">@number</span>
                    <span class="player-info">
                        <span class="player-name" title="@(string.IsNullOrWhiteSpace(name) ? "GIOCATORE" : name)">@(string.IsNullOrWhiteSpace(name) ? "GIOCATORE" : name)</span>
                        <span class="player-indicators">
                            <span class="stat-item goal-indicator">G @Game.PlayerGoals(Team, number)</span>
                            <span class="stat-item penalty-indicator">7m @Game.PlayerPenaltyGoals(Team, number)</span>
                            <span class="stat-item amm-indicator @(yellow ? "active" : "")">A</span>
                            @if (red)
                            {
                                <span class="stat-item expelled-indicator">ESPULSO</span>
                            }
                            else
                            {
                                <span class="stat-item two-count @(Game.PlayerTwoCount(Team, number) >= 3 ? "danger" : Game.PlayerTwoCount(Team, number) > 0 ? "active" : "")">2 @Game.PlayerTwoCount(Team, number)/3</span>
                            }
                        </span>
                        @if (suspensions.Count > 0)
                        {
                            <span class="active-countdown-row">
                                @foreach (var suspension in suspensions)
                                {
                                    <span class="active-countdown @(suspension.IsRed ? "countdown-red" : "countdown-two")">@(suspension.IsRed ? "E" : "2'") @suspension.Remaining</span>
                                }
                            </span>
                        }
                    </span>
                </button>
            }
        }
    </div>
    @if (!Game.State.ShootoutStarted)
    {
    <div class="staff-row">
        @for (var i = 0; i < 5; i++)
        {
            var staffIndex = i;
            var staff = GetStaff(staffIndex);
            var staffYellow = Game.StaffHasYellow(Team, staff.Letter);
            var staffRed = Game.StaffHasRed(Team, staff.Letter);
            var staffSuspensions = Game.GetStaffSuspensions(Team, staff.Letter).ToList();
            if (staff.Active && !string.IsNullOrWhiteSpace(staff.Letter))
            {
            <button type="button" disabled="@(!staff.Active || staffRed)" aria-label="Dirigente @staff.Letter @(string.IsNullOrWhiteSpace(staff.Name) ? "senza nome" : staff.Name)" class="staff-card @(!staff.Active ? "inactive-staff" : "") @(staffRed ? "has-red" : "") @(Game.PendingEvent is not null && staff.Active && !staffRed ? "touch-ready" : "")" style="background:@TeamColor;color:@TeamTextColor;border-color:@TeamColor" @onclick="() => SelectStaff(staffIndex)">
                <span class="staff-status-area">
                    <span class="staff-identity-badge" style="background:@TeamColor;color:@TeamTextColor;border-color:@TeamColor">@staff.Letter</span>
                    <span class="staff-sanction-badges">
                        <span class="staff-sanction-badge staff-sanction-yellow @(staffYellow ? "is-active" : "")">A</span>
                        <span class="staff-sanction-badge staff-sanction-two @(staffSuspensions.Count > 0 ? "is-active" : "")">2</span>
                        <span class="staff-sanction-badge staff-sanction-red @(staffRed ? "is-active" : "")">E</span>
                        @if (staffSuspensions.Count > 0)
                        {
                            <span class="staff-active-countdown">
                                @foreach (var s in staffSuspensions)
                                {
                                    <span class="active-countdown">2' @s</span>
                                }
                            </span>
                        }
                    </span>
                </span>
                <span class="staff-info">
                    <span class="staff-name" title="@staff.Name">@staff.Name</span>
                </span>
            </button>
            }
        }
    </div>
    }
</section>

@code {
    protected override void OnInitialized()
    {
        Game.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Game.Changed -= OnChanged;
    }

    [Parameter] public string Team { get; set; } = "A";
    [Parameter] public string Title { get; set; } = "CASA";

    private string TeamColor => Team == "A" ? Game.State.Casa.Color : Game.State.Ospiti.Color;

    private string TeamTextColor => GetContrastTextColor(TeamColor);

    private static string GetContrastTextColor(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#ffffff";
        var h = hex.Trim().TrimStart('#');
        if (h.Length == 3) h = string.Concat(h.Select(c => new string(c, 2)));
        if (h.Length != 6) return "#ffffff";
        if (!int.TryParse(h.Substring(0, 2), System.Globalization.NumberStyles.HexNumber, null, out var r) ||
            !int.TryParse(h.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out var g) ||
            !int.TryParse(h.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out var b)) return "#ffffff";
        var luminance = (0.299 * r + 0.587 * g + 0.114 * b);
        return luminance >= 160 ? "#111827" : "#ffffff";
    }

    private void OpenShootout(int index) => Game.OpenShootoutShot(Team, index);

    private void SelectPlayer(int index)
    {
        var roster = Team == "A" ? Game.State.Casa : Game.State.Ospiti;
        if (Game.PendingEvent is null || Game.State.MatchFinished || Game.State.ShootoutStarted || !roster.ActivePlayers[index]) return;
        var number = roster.NumberLabels is { Length: 16 } ? (roster.NumberLabels[index] ?? string.Empty).Trim() : string.Empty;
        if (string.IsNullOrWhiteSpace(number)) return;
        if (Game.PlayerHasRed(Team, number)) return;
        Game.CompletePendingPlayer(Team, index);
    }
    private void SelectStaff(int index)
    {
        var roster = Team == "A" ? Game.State.Casa : Game.State.Ospiti;
        if (Game.PendingEvent is null || Game.State.MatchFinished || Game.State.ShootoutStarted || !roster.ActiveStaff[index]) return;
        Game.SelectStaff(Team == "A" ? 0 : 1, index);
    }
    private IEnumerable<int> OrderedPlayerIndices()
    {
        var roster = Team == "A" ? Game.State.Casa : Game.State.Ospiti;
        return Enumerable.Range(0, 16)
            .Where(i => roster.ActivePlayers[i] && !string.IsNullOrWhiteSpace(GetNumberLabel(roster, i)))
            .OrderBy(i => NumberSortKey(GetNumberLabel(roster, i)))
            .ThenBy(i => i);
    }

    private static string GetNumberLabel(TeamState roster, int index)
    {
        if (roster.NumberLabels is { Length: 16 })
            return (roster.NumberLabels[index] ?? string.Empty).Trim();
        return string.Empty;
    }

    private static int NumberSortKey(string label)
    {
        if (label == "0") return 0;
        if (label == "00") return 1;
        if (int.TryParse(label, out var n) && n >= 1 && n <= 99) return n + 1;
        return 1000;
    }

    private (string Letter, string Name, bool Active) GetStaff(int i)
    {
        var t = Team == "A" ? Game.State.Casa : Game.State.Ospiti;
        return (t.StaffLetters[i] ?? string.Empty, string.IsNullOrWhiteSpace(t.StaffNames[i]) ? "DIRIGENTE" : t.StaffNames[i], t.ActiveStaff[i]);
    }
}

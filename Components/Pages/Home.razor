@page "/"
@using Microsoft.JSInterop
@using RefertoPallamano_Blazor.Models
@using System.Linq
@implements IDisposable
@inject GameService Game
@inject IJSRuntime JS

<PageTitle>Referto Pallamano</PageTitle>

<div class="match-app tablet-app">
    <header class="topbar">
        <div class="brand"><img src="images/FIGH.png" alt="FIGH" /><div><div class="federation">FEDERAZIONE ITALIANA GIUOCO HANDBALL</div><div class="app-title">REFERTO PALLAMANO</div></div></div>
        <div class="phase-box">@GameService.PhaseName(Game.State.Phase)</div>
    </header>

    <section class="scorebar">
        <div class="team-score home-score"><div class="team-score-info"><span>@Game.State.Casa.Name</span></div><strong>@Game.State.ScoreA</strong></div>
        <div class="clock-area">
            <div class="clock @(Game.State.Running ? "clock-running" : "clock-stopped")">@GameService.FormatTime(Game.State.TimerSeconds)</div>
            @if (Game.State.TimeoutRemainingSeconds > 0)
            {
                <div class="match-timeout-countdown">TIME OUT @(Game.State.TimeoutTeam == "A" ? Game.State.Casa.Name : Game.State.Ospiti.Name) · @GameService.FormatTime(Game.State.TimeoutRemainingSeconds)</div>
            }
            <div class="timer-command-card">
                <div class="timer-command-row">
                    <button type="button" class="event-button cancel timer-command-button" @onclick="CancelEvent" disabled="@(Game.PendingEvent is null)">ANNULLA</button>
                    <button type="button" class="primary start-button timer-command-button @(Game.State.Running ? "stop-active" : "start-active")" @onclick="Game.StartStop">@(Game.State.Running ? "STOP" : "START")</button>
                    <button type="button" class="event-button undo timer-command-button" @onclick="UndoEvent" disabled="@(!Game.CanUndo)">UNDO</button>
                </div>
            </div>
        </div>
        <div class="team-score away-score"><strong>@Game.State.ScoreB</strong><div class="team-score-info"><span>@Game.State.Ospiti.Name</span></div></div>
    </section>

    <main class="three-columns">
        <aside class="event-rail event-rail-home" aria-label="Eventi CASA">
            @foreach (var e in EventTypes)
            {
                <button type="button" class="event-button @e.Css @(Game.PendingEvent?.Type == e.Code ? "selected" : "")" @onclick="() => SelectEvent(e.Code)">@e.Label</button>
            }
                    <button type="button" class="event-button timeout" @onclick='() => RegisterTimeout("A")' disabled="@(Game.TimeoutCount("A") >= 3)">TIME OUT</button>
        </aside>
        <TeamPanel Team="A" Title="CASA" />
        <section class="log-panel">
            <div class="panel-title">REGISTRO GARA</div>
            <div class="event-list">
                <div class="event-row event-header">
                    <span>Tempo</span><span>Sq</span><span>N.</span><span>Evento</span><strong>Ris.</strong>
                </div>
                @for (var displayIndex = Game.State.Events.Count - 1; displayIndex >= 0; displayIndex--)
                {
                    var ev = Game.State.Events[displayIndex];
                    <div class="event-row event-row-button @(ev.Type == "SYSTEM" ? "system-row" : "")" style="--event-team-color:@GetEventTeamColor(ev.Team)"
                         @onclick="@(ev.Type == "SYSTEM" ? null : (() => OpenEventEditor(displayIndex)))"
                         @onclick:stopPropagation="true"
                         role="@(ev.Type == "SYSTEM" ? null : "button")"
                         tabindex="@(ev.Type == "SYSTEM" ? null : "0")">
                        <span class="event-time">@ev.Time</span>
                        <span class="event-team-cell">@ev.Team</span>
                        <span class="event-number">@(ev.Number == "—" ? "" : ev.Number)</span>
                        <span class="event-description">@ev.Text</span>
                        <strong class="event-result">@ev.Result</strong>
                    </div>
                }
                @if (Game.State.Events.Count == 0) { <div class="empty-log">Nessun evento registrato</div> }
            </div>
        </section>
        <TeamPanel Team="B" Title="OSPITI" />
        <aside class="event-rail event-rail-away" aria-label="Eventi OSPITI">
            @foreach (var e in EventTypes)
            {
                <button type="button" class="event-button @e.Css @(Game.PendingEvent?.Type == e.Code ? "selected" : "")" @onclick="() => SelectEvent(e.Code)">@e.Label</button>
            }
                    <button type="button" class="event-button timeout" @onclick='() => RegisterTimeout("B")' disabled="@(Game.TimeoutCount("B") >= 3)">TIME OUT</button>
        </aside>
    </main>

    <footer class="bottom-bar">
        <button @onclick="SaveGame">💾 SALVA GARA</button>
        <button @onclick="RestoreRecovery">↩ RIPRISTINA</button>
        <button @onclick="LoadMatchData">📥 CARICA DATI GARA</button>
        <button @onclick="PrintReferto">📄 REFERTO</button>
        <button @onclick="Game.OpenConfiguration" disabled="@Game.State.MatchStarted">⚙ CONFIGURAZIONE</button>
        <button @onclick="Game.FinishCurrentPeriod" disabled="@(Game.State.MatchFinished || Game.State.ShootoutStarted)">FINE PERIODO</button>
        <button @onclick="ProceedToNextPeriod" disabled="@(Game.PeriodStartConfirmed || Game.State.MatchFinished)">PROSSIMO PERIODO</button>
        <span class="status">@(Game.State.MatchFinished ? "GARA TERMINATA" : Game.State.ShootoutStarted ? "TIRI DI RIGORE" : Game.State.Running ? "CRONOMETRO ATTIVO" : "PRONTA / FERMA")</span>
    </footer>
</div>

@if (Game.ShowConfiguration)
{
    <div class="overlay config-overlay"><div class="config-card">
        <div class="dialog-kicker">CONFIGURAZIONE GARA</div>
        <h2>REFERTO PALLAMANO · iPad 11"</h2>
        <div class="config-grid">
            <label>Numero gara<input @bind="Game.State.MatchNumber" @bind:event="oninput" /></label>
            <label>Campionato<input @bind="Game.State.Championship" @bind:event="oninput" /></label>
            <label>Data<input @bind="Game.State.MatchDate" @bind:event="oninput" /></label>
            <label>Ora<input @bind="Game.State.MatchTime" @bind:event="oninput" /></label>
            <label>Località<input @bind="Game.State.City" @bind:event="oninput" /></label>
            <label>Impianto<input @bind="Game.State.Venue" @bind:event="oninput" /></label>
            <label>Squadra CASA<input @bind="Game.State.Casa.Name" @bind:event="oninput" /></label>
            <label>Squadra OSPITI<input @bind="Game.State.Ospiti.Name" @bind:event="oninput" /></label>
            <label>Arbitro 1<input @bind="Game.State.Referee1" @bind:event="oninput" /></label>
            <label>Arbitro 2<input @bind="Game.State.Referee2" @bind:event="oninput" /></label>
            <label>Delegato<input @bind="Game.State.Delegate1" @bind:event="oninput" /></label>
            <label>Segretario<input @bind="Game.State.Secretary" @bind:event="oninput" /></label>
        </div>
        <div class="config-top-row">
            <div class="team-color-config-box team-color-home">
                <strong>COLORE CASA</strong>
                <div class="team-color-palette">
                    @foreach (var c in TeamColors)
                    {
                        <button type="button" title="@c.Name" aria-label="Colore CASA @c.Name" class="team-color-swatch @(Game.State.Casa.Color == c.Hex ? "selected" : "")" style="background:@c.Hex" @onclick='() => SetTeamColor("A", c.Hex)'></button>
                    }
                </div>
            </div>

            <div class="config-center-settings">
                <div class="config-duration">
                    <div class="section-label">DURATA DI OGNI TEMPO</div>
                    <input class="duration-input" type="number" min="1" max="60" @bind="Game.State.HalfDurationMinutes" />
                    <span>MINUTI</span>
                </div>
                <div class="config-options">
                    @if (!string.IsNullOrWhiteSpace(Game.ValidationError)) { <div class="validation-error">@Game.ValidationError</div> }
                    <label class="check"><input type="checkbox" @bind="Game.State.CronometroContinuativo" /> CRONOMETRO PALAZZETTO CONTINUATIVO</label>
                    <label class="check"><input type="checkbox" @bind="Game.State.RichiediCartellinoEsclusione" /> STAMPA CARTELLINI</label>
                </div>
            </div>

            <div class="team-color-config-box team-color-away">
                <strong>COLORE OSPITI</strong>
                <div class="team-color-palette">
                    @foreach (var c in TeamColors)
                    {
                        <button type="button" title="@c.Name" aria-label="Colore OSPITI @c.Name" class="team-color-swatch @(Game.State.Ospiti.Color == c.Hex ? "selected" : "")" style="background:@c.Hex" @onclick='() => SetTeamColor("B", c.Hex)'></button>
                    }
                </div>
            </div>
        </div>
        <div class="mode-section">
            <div class="section-label">MODALITÀ GARA</div>
            <div class="mode-grid">
                <button type="button" class="mode-card @(Game.State.MatchMode == "STANDARD" ? "selected" : "")" @onclick='() => Game.State.MatchMode = "STANDARD"'>
                    <strong>PARTITA STANDARD</strong><small>1° tempo + 2° tempo. Al termine della gara si conclude la partita.</small>
                </button>
                <button type="button" class="mode-card @(Game.State.MatchMode == "SUPPLEMENTARI" ? "selected" : "")" @onclick='() => Game.State.MatchMode = "SUPPLEMENTARI"'>
                    <strong>CON SUPPLEMENTARI</strong><small>In caso di parità: 2 tempi da 5' + 2 tempi da 5' se necessario.</small>
                </button>
                <button type="button" class="mode-card @(Game.State.MatchMode == "RIGORI" ? "selected" : "")" @onclick='() => Game.State.MatchMode = "RIGORI"'>
                    <strong>CON TIRI DI RIGORE</strong><small>Al termine dei 2 tempi, se necessario, si passa direttamente ai tiri di rigore.</small>
                </button>
            </div>
        </div>
        <div class="roster-config">
            <div><h3>CASA · GIOCATORI</h3><div class="roster-mini">@for (var i = 0; i < 16; i++) { var ix=i; <div class="roster-row"><input class="roster-number-input" type="text" inputmode="numeric" maxlength="2" value='@GetNumberLabel("A", ix)' @oninput='e => SetNumberLabel("A", ix, e.Value?.ToString())' /><input class="roster-name-input" type="text" placeholder="Nome giocatore" @bind="Game.State.Casa.PlayerNames[ix]" @bind:event="oninput" /><label><input type="checkbox" @bind="Game.State.Casa.ActivePlayers[ix]" /> IN</label></div> }</div>
                <h3>CASA · DIRIGENTI</h3><div class="staff-config-mini">@for (var i = 0; i < 5; i++) { var ix=i; <div class="roster-row"><span class="staff-letter">@Game.State.Casa.StaffLetters[ix]</span><input class="roster-name-input" type="text" placeholder="Nome dirigente" @bind="Game.State.Casa.StaffNames[ix]" @bind:event="oninput" /><label><input type="checkbox" @bind="Game.State.Casa.ActiveStaff[ix]" /> IN</label></div> }</div>
            </div>
            <div><h3>OSPITI · GIOCATORI</h3><div class="roster-mini">@for (var i = 0; i < 16; i++) { var ix=i; <div class="roster-row"><input class="roster-number-input" type="text" inputmode="numeric" maxlength="2" value='@GetNumberLabel("B", ix)' @oninput='e => SetNumberLabel("B", ix, e.Value?.ToString())' /><input class="roster-name-input" type="text" placeholder="Nome giocatore" @bind="Game.State.Ospiti.PlayerNames[ix]" @bind:event="oninput" /><label><input type="checkbox" @bind="Game.State.Ospiti.ActivePlayers[ix]" /> IN</label></div> }</div>
                <h3>OSPITI · DIRIGENTI</h3><div class="staff-config-mini">@for (var i = 0; i < 5; i++) { var ix=i; <div class="roster-row"><span class="staff-letter">@Game.State.Ospiti.StaffLetters[ix]</span><input class="roster-name-input" type="text" placeholder="Nome dirigente" @bind="Game.State.Ospiti.StaffNames[ix]" @bind:event="oninput" /><label><input type="checkbox" @bind="Game.State.Ospiti.ActiveStaff[ix]" /> IN</label></div> }</div>
            </div>
        </div>
        <div class="config-actions">
            <button class="primary dialog-main compact-action" @onclick="SaveConfiguration">SALVA E INIZIA</button>
            <button type="button" class="import-match-button compact-action" @onclick="LoadMatchData">📥 CARICA DATI GARA</button>
            <button type="button" class="restore-button compact-action" @onclick="RestoreRecovery">↩ RIPRISTINA</button>
        </div>
        <div class="import-hint config-action-hint">Carica distinta e dati gara da file Excel · Ripristina l'ultima situazione salvata automaticamente</div>
    </div></div>
}

@if (Game.ShowPeriodEnd)
{
    <div class="overlay"><div class="dialog-card">
        <div class="dialog-kicker">PERIODO TERMINATO</div>
        <h2>@GameService.PhaseName(Game.State.Phase)</h2>
        <div class="dialog-score">@Game.State.ScoreA <span>—</span> @Game.State.ScoreB</div>
        <p>Il cronometro è stato fermato. Conferma per procedere.</p>
        <button class="primary dialog-main" @onclick="ProceedToNextPeriod">PROSEGUI</button>
        <button @onclick="Game.ClosePeriodDialog">CHIUDI</button>
    </div></div>
}

@if (Game.ShowShootoutStart)
{
    <div class="overlay"><div class="dialog-card shootout-dialog">
        <div class="dialog-kicker">GARA ANCORA IN PARITÀ</div>
        <h2>INIZIO TIRI DI RIGORE</h2>
        <div class="dialog-score">@Game.State.ScoreA <span>—</span> @Game.State.ScoreB</div>
        <p>Dopo il 4° tempo supplementare il risultato è in parità.</p>
        <button class="primary dialog-main" @onclick="Game.ConfirmShootoutStart">INIZIA TIRI DI RIGORE</button>
        <button @onclick="Game.CancelShootoutStart">ANNULLA</button>
    </div></div>
}

@if (Game.PendingYellow is not null)
{
    <div class="overlay"><div class="dialog-card"><div class="dialog-kicker">DECISIONE DISCIPLINARE</div><h2>AMMONIZIONE NON DISPONIBILE</h2><p>@(Game.PendingYellow?.IsStaff == true ? "Un dirigente della squadra ha già ricevuto l'unica ammonizione consentita alla panchina oppure la squadra ha raggiunto il limite di tre ammonizioni." : "Il giocatore ha già un'ammonizione oppure la squadra ha raggiunto il limite di tre ammonizioni.")</p><div class="dialog-grid"><button @onclick='() => Game.ResolveYellow("TWO")'>2 MINUTI</button><button class="danger" @onclick='() => Game.ResolveYellow("RED")'>ESPULSIONE</button><button @onclick='() => Game.ResolveYellow("CANCEL")'>ANNULLA</button></div></div></div>
}

@if (_eventEditorOpen && _editingEvent is not null)
{
    <div class="overlay event-editor-overlay">
        <div class="dialog-card event-editor-dialog">
            <div class="dialog-kicker">REGISTRO GARA</div>
            <h2>MODIFICA EVENTO</h2>
            <div class="event-editor-grid">
                <label>Tempo<input type="text" @bind="_editTime" /></label>
                <label>Squadra
                    <select @bind="_editTeam" @bind:after="RefreshEditorParticipants">
                        <option value="A">CASA</option>
                        <option value="B">OSPITI</option>
                    </select>
                </label>
                <label>Numero / Dirigente
                    <select @bind="_editNumber" disabled="@(_editType == "TIMEOUT")">
                        @if (_editType == "TIMEOUT")
                        {
                            <option value="">—</option>
                        }
                        else
                        {
                            @foreach (var p in GetEditorParticipants(_editTeam))
                            {
                                <option value="@p.Value">@p.Label</option>
                            }
                        }
                    </select>
                </label>
                <label>Evento
                    <select @bind="_editType" @bind:after="RefreshEditorParticipants">
                        <option value="GOAL">RETE</option>
                        <option value="PENALTY_GOAL">RIGORE REALIZZATO</option>
                        <option value="PENALTY_MISS">RIGORE ERRATO</option>
                        <option value="YELLOW">AMMONIZIONE</option>
                        <option value="TWO">2'</option>
                        <option value="RED">ESPULSIONE</option>
                        <option value="TIMEOUT">TIME OUT</option>
                    </select>
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_eventEditorError))
            {
                <div class="validation-error">@_eventEditorError</div>
            }
            <div class="event-editor-actions">
                <button type="button" class="danger" @onclick="DeleteEditingEvent">ELIMINA</button>
                <button type="button" @onclick="CloseEventEditor">ANNULLA</button>
                <button type="button" class="primary" @onclick="SaveEditingEvent">SALVA</button>
            </div>
        </div>
    </div>
}

@if (Game.State.TimeoutRemainingSeconds > 0)
{
    <div class="overlay timeout-overlay">
        <div class="dialog-card timeout-dialog @(Game.State.TimeoutTeam == "A" ? "timeout-team-a" : "timeout-team-b")">
            <div class="dialog-kicker">TIME OUT</div>
            <h2>TIME OUT · @(Game.State.TimeoutTeam == "A" ? Game.State.Casa.Name : Game.State.Ospiti.Name)</h2>
            <div class="timeout-big-countdown">@GameService.FormatTime(Game.State.TimeoutRemainingSeconds)</div>
            <p>Il cronometro di gara è fermo.</p>
            <button type="button" class="timeout-exit-button" @onclick="Game.ExitTimeout">ESCI TIME OUT</button>
        </div>
    </div>
}

@code {
    private static readonly (string Name, string Hex)[] TeamColors = [
        ("BLU", "#2563eb"), ("VIOLA", "#7c3aed"), ("VERDE", "#16a34a"),
        ("ARANCIONE", "#ea580c"), ("ROSSO", "#dc2626"), ("NERO", "#111827"),
        ("GIALLO", "#eab308")
    ];

    private string GetNumberLabel(string team, int index)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        if (roster.NumberLabels is { Length: 16 } && !string.IsNullOrWhiteSpace(roster.NumberLabels[index])) return roster.NumberLabels[index];
        return roster.Numbers[index].ToString();
    }

    private void SetNumberLabel(string team, int index, string? value)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        value ??= string.Empty;
        if (value.Length > 2 || value.Any(c => !char.IsDigit(c))) return;
        roster.NumberLabels[index] = value;
        roster.Numbers[index] = int.TryParse(value, out var n) ? n : -1;
    }

    private static double NumberSortKey(string? label, int fallback)
    {
        var v = (label ?? string.Empty).Trim();
        if (v == "0") return 0;
        if (v == "00") return 0.5;
        if (int.TryParse(v, out var n) && n >= 1) return n;
        return fallback >= 1 ? fallback : 9999;
    }

    private void SetTeamColor(string team, string color) => Game.SetTeamColor(team, color);

    private readonly (string Code, string Label, string Css)[] EventTypes = [
        ("GOAL", "GOAL", "goal"),
        ("PENALTY_GOAL", "7m GOAL", "penalty-goal"),
        ("PENALTY_MISS", "7m MISS", "penalty-miss"),
        ("YELLOW", "AMMONIZIONE", "yellow"),
        ("TWO", "2'", "two"),
        ("RED", "ESPULSIONE DIRETTA", "red")];

    protected override void OnInitialized()
    {
        Game.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _ = InvokeAsync(StateHasChanged);
        // Il recovery viene scritto immediatamente a ogni modifica reale
        // della gara, non soltanto dopo un render della pagina.
        _ = SaveRecoveryIfReady();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Leggiamo prima il recovery esistente. L'app non deve mai
            // sovrascriverlo all'avvio con una gara vuota.
            var existingRecovery = await JS.InvokeAsync<string?>("recuperaPartitaLocale");
            // IMPORTANTISSIMO: all'avvio il recovery può contenere una gara
            // precedente. Non deve essere sovrascritto dalla GameState vuota.
            // Il confronto parte dallo stato appena creato e il primo autosave
            // avviene soltanto quando lo stato cambia realmente.
            _lastRecoveryJson = Game.ExportJson();
            _recoveryReady = true;
            _recoveryAvailable = !string.IsNullOrWhiteSpace(existingRecovery);

            // Il recovery viene registrato autonomamente anche quando
            // l'utente modifica campi della distinta/configurazione che
            // non passano da Game.Notify(), e durante il trascorrere del
            // cronometro.
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("avviaAutoRecovery", _selfRef);
        }
    }

    private async Task SaveRecoveryIfReady()
    {
        if (!_recoveryReady) return;
        try
        {
            var json = Game.ExportJson();
            if (!string.Equals(json, _lastRecoveryJson, StringComparison.Ordinal))
            {
                await JS.InvokeVoidAsync("salvaPartitaLocale", json);
                _lastRecoveryJson = json;
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private bool _eventEditorOpen;
    private int? _editingEvent;
    private string _editTime = "00:00";
    private string _editTeam = "A";
    private string _editNumber = "";
    private string _editType = "GOAL";
    private string _eventEditorError = "";

    private IEnumerable<(string Value, string Label)> GetEditorParticipants(string team)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        for (var i = 0; i < 16; i++)
        {
            if (!roster.ActivePlayers[i]) continue;
            var n = GetNumberLabel(team, i).Trim();
            if (string.IsNullOrWhiteSpace(n)) continue;
            yield return (n, $"{n} - {roster.PlayerNames[i]}");
        }
        for (var i = 0; i < 5; i++)
        {
            if (!roster.ActiveStaff[i]) continue;
            var l = roster.StaffLetters[i];
            yield return (l, $"{l} - {roster.StaffNames[i]}");
        }
    }

    private void OpenEventEditor(int index)
    {
        if (index < 0 || index >= Game.State.Events.Count) return;
        var ev = Game.State.Events[index];
        if (ev.Type == "SYSTEM") return;
        _editingEvent = index;
        _eventEditorOpen = true;
        _editTime = ev.Time;
        _editTeam = ev.Team is "A" or "B" ? ev.Team : "A";
        _editNumber = ev.Number == "—" ? "" : ev.Number;
        _editType = ev.Type switch
        {
            "TIMEOUT" or "T.O." or "TO" => "TIMEOUT",
            "GOAL" => "GOAL",
            "PENALTY_GOAL" => "PENALTY_GOAL",
            "PENALTY_MISS" => "PENALTY_MISS",
            "YELLOW" => "YELLOW",
            "TWO" => "TWO",
            "RED" => "RED",
            _ => "GOAL"
        };
        _eventEditorError = "";
        StateHasChanged();
    }

    private void RefreshEditorParticipants()
    {
        if (_editType == "TIMEOUT") { _editNumber = ""; return; }
        if (!GetEditorParticipants(_editTeam).Any(p => p.Value == _editNumber))
            _editNumber = GetEditorParticipants(_editTeam).Select(p => p.Value).FirstOrDefault() ?? "";
    }

    private void CloseEventEditor()
    {
        _eventEditorOpen = false;
        _editingEvent = null;
        _eventEditorError = "";
    }

    private void SaveEditingEvent()
    {
        if (_editingEvent is null) return;
        if (!Game.CanEditEvents)
        {
            _eventEditorError = "Ferma il cronometro prima di salvare la modifica.";
            return;
        }
        if (!Game.EditEvent(_editingEvent.Value, _editTime, _editTeam, _editNumber, _editType))
        {
            _eventEditorError = "Modifica non valida. Controlla tempo, squadra e tesserato.";
            return;
        }
        CloseEventEditor();
    }

    private void DeleteEditingEvent()
    {
        if (_editingEvent is null) return;
        if (!Game.DeleteEvent(_editingEvent.Value))
        {
            _eventEditorError = "L'evento non può essere eliminato in questo momento.";
            return;
        }
        CloseEventEditor();
    }

    private void SelectEvent(string code)
    {
        if (Game.State.MatchFinished || Game.State.ShootoutStarted) return;
        Game.SelectEvent(code);
    }

    private void CancelEvent() => Game.CancelPendingEvent();

    private void RegisterTimeout(string team)
    {
        Game.RegisterTimeout(team);
    }
    private void UndoEvent() => Game.Undo();

    private async Task SaveConfiguration()
    {
        if (Game.CloseConfiguration())
            await SaveRecoveryIfReady();
    }

    private void ProceedToNextPeriod() { Game.NextPeriod(); }
    private bool _recoveryReady;
    private bool _recoveryAvailable;
    private string? _lastRecoveryJson;
    private string GetEventTeamColor(string team)
    {
        if (team == "A") return Game.State.Casa.Color;
        if (team == "B") return Game.State.Ospiti.Color;
        return "#64748b";
    }

    private async Task SaveGame() => await JS.InvokeVoidAsync("refertoDownload", "RefertoPallamano.json", Game.ExportJson());
    private async Task RestoreRecovery()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("recuperaPartitaLocale");
            if (string.IsNullOrWhiteSpace(json))
            {
                Game.SetValidationMessage("NESSUN RECUPERO AUTOMATICO DISPONIBILE");
                return;
            }
            Game.ImportJson(json);
            _lastRecoveryJson = json;
            _recoveryReady = true;
            _recoveryAvailable = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Game.SetValidationMessage("RIPRISTINO NON RIUSCITO: " + ex.Message);
        }
    }

    private async Task SaveRecovery()
    {
        if (_recoveryReady) await JS.InvokeVoidAsync("salvaPartitaLocale", Game.ExportJson());
    }

    private DotNetObjectReference<Home>? _selfRef;
    private async Task LoadMatchData()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("apriCaricamentoExcel", _selfRef);
    }

    [JSInvokable("AutoSaveRecovery")]
    public async Task AutoSaveRecovery()
    {

    }

    [JSInvokable("ImportMatchData")]
    public void ImportMatchData(ImportedMatchData d)
    {
        Game.State.MatchNumber = d.MatchNumber ?? "";
        Game.State.MatchDate = d.Date ?? "";
        Game.State.MatchTime = d.Time ?? "";
        Game.State.Championship = d.Championship ?? "";
        Game.State.City = d.City ?? "";
        Game.State.Venue = d.Venue ?? "";
        Game.State.Season = d.Season ?? "";
        Game.State.Referee1 = d.Referee1 ?? "";
        Game.State.Referee2 = d.Referee2 ?? "";
        Game.State.Delegate1 = d.Delegate1 ?? "";
        Game.State.Delegate2 = d.Delegate2 ?? "";
        Game.State.Timekeeper = d.Timekeeper ?? "";
        Game.State.Secretary = d.Secretary ?? "";
        if (!string.IsNullOrWhiteSpace(d.TeamA)) Game.State.Casa.Name = d.TeamA;
        if (!string.IsNullOrWhiteSpace(d.TeamB)) Game.State.Ospiti.Name = d.TeamB;
        LoadPlayers(Game.State.Casa, d.PlayersA);
        LoadPlayers(Game.State.Ospiti, d.PlayersB);
        LoadStaff(Game.State.Casa, d.StaffA);
        LoadStaff(Game.State.Ospiti, d.StaffB);
        StateHasChanged();
    }

    private static void LoadPlayers(TeamState team, ImportedPlayer[]? players)
    {
        team.Numbers = Enumerable.Range(1, 16).ToArray();
        team.NumberLabels = Enumerable.Range(1, 16).Select(n => n.ToString()).ToArray();
        team.PlayerNames = new string[16];
        team.ActivePlayers = new bool[16];
        var slot = 0;
        foreach (var p in (players ?? Array.Empty<ImportedPlayer>()).Take(16))
        {
            var label = (p.Number ?? string.Empty).Trim();
            if (label != "0" && label != "00" && (!int.TryParse(label, out var parsed) || parsed < 1 || parsed > 99)) continue;
            if (slot >= 16) break;
            team.Numbers[slot] = int.TryParse(label, out var parsedNumber) ? parsedNumber : 0;
            team.NumberLabels[slot] = label;
            team.PlayerNames[slot] = p.Name ?? "";
            team.ActivePlayers[slot] = true;
            slot++;
        }
    }

    private static void LoadStaff(TeamState team, ImportedStaff[]? staff)
    {
        team.StaffLetters = ["A", "B", "C", "D", "E"];
        team.StaffNames = new string[5];
        team.ActiveStaff = Enumerable.Repeat(true, 5).ToArray();
        foreach (var p in (staff ?? Array.Empty<ImportedStaff>()))
        {
            var i = Array.IndexOf(team.StaffLetters, (p.Letter ?? "").ToUpperInvariant());
            if (i >= 0) team.StaffNames[i] = p.Name ?? "";
        }
    }

    public sealed class ImportedMatchData
    {
        public string? MatchNumber { get; set; } public string? Date { get; set; } public string? Time { get; set; }
        public string? Championship { get; set; } public string? City { get; set; } public string? Venue { get; set; } public string? Season { get; set; }
        public string? Referee1 { get; set; } public string? Referee2 { get; set; } public string? Delegate1 { get; set; } public string? Delegate2 { get; set; }
        public string? Timekeeper { get; set; } public string? Secretary { get; set; } public string? TeamA { get; set; } public string? TeamB { get; set; }
        public ImportedPlayer[]? PlayersA { get; set; } public ImportedPlayer[]? PlayersB { get; set; }
        public ImportedStaff[]? StaffA { get; set; } public ImportedStaff[]? StaffB { get; set; }
    }
    public sealed class ImportedPlayer { public string? Number { get; set; } public string? Name { get; set; } }
    public sealed class ImportedStaff { public string? Letter { get; set; } public string? Name { get; set; } }

    private async Task PrintReferto()
    {
        await JS.InvokeVoidAsync("stampaReferto", new
        {
            matchNumber = Game.State.MatchNumber,
            date = Game.State.MatchDate,
            time = Game.State.MatchTime,
            championship = Game.State.Championship,
            city = Game.State.City,
            venue = Game.State.Venue,
            casa = Game.State.Casa.Name,
            ospiti = Game.State.Ospiti.Name,
            colorA = Game.State.Casa.Color,
            colorB = Game.State.Ospiti.Color,
            scoreA = Game.State.ScoreA,
            scoreB = Game.State.ScoreB,
            playersA = Game.State.Casa.Numbers.Select((n,i) => new { number=n, label=GetNumberLabel("A", i), name=Game.State.Casa.PlayerNames[i] ?? "", active=Game.State.Casa.ActivePlayers[i], originalIndex=i }).Where(p => p.active).OrderBy(p => NumberSortKey(p.label, p.number)).ThenBy(p => p.originalIndex).ToArray(),
            playersB = Game.State.Ospiti.Numbers.Select((n,i) => new { number=n, label=GetNumberLabel("B", i), name=Game.State.Ospiti.PlayerNames[i] ?? "", active=Game.State.Ospiti.ActivePlayers[i], originalIndex=i }).Where(p => p.active).OrderBy(p => NumberSortKey(p.label, p.number)).ThenBy(p => p.originalIndex).ToArray(),
            staffA = Game.State.Casa.StaffLetters.Select((l,i) => new { letter=l, name=Game.State.Casa.StaffNames[i] ?? "", active=Game.State.Casa.ActiveStaff[i] }).Where(p => p.active),
            staffB = Game.State.Ospiti.StaffLetters.Select((l,i) => new { letter=l, name=Game.State.Ospiti.StaffNames[i] ?? "", active=Game.State.Ospiti.ActiveStaff[i] }).Where(p => p.active),
            events = Game.State.Events.Select(e => new { e.Time, e.Team, e.Number, e.Text, e.Result })
        });
    }
    public async void Dispose()
    {
        Game.Changed -= OnChanged;
        try { await JS.InvokeVoidAsync("fermaAutoRecovery"); } catch { }
        _selfRef?.Dispose();
    }

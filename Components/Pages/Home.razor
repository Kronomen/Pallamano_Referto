@page "/"
@using Microsoft.JSInterop
@using RefertoPallamano_Blazor.Models
@using System.Linq
@implements IDisposable
@inject GameService Game
@inject IJSRuntime JS

<PageTitle>Referto Pallamano</PageTitle>

<div class="match-app tablet-app">
    @if (Game.State.ShootoutStarted)
    {
        <header class="shootout-header">
            <div class="shootout-brand">
                <img src="images/FIGH.png" alt="FIGH" />
                <div class="shootout-federation">FEDERAZIONE<br />ITALIANA<br />GIUOCO HANDBALL</div>
            </div>
            <div class="shootout-teams-score">
                <div class="shootout-team-name home">@Game.State.Casa.Name<span>CASA</span></div>
                <div class="shootout-main-score">@Game.State.ShootoutScoreA <span>−</span> @Game.State.ShootoutScoreB</div>
                <div class="shootout-team-name away">@Game.State.Ospiti.Name<span>OSPITI</span></div>
            </div>
            <div class="shootout-official-brand">
                <div class="official-symbol">F.I.Cr.</div>
                <div>FEDERAZIONE ITALIANA<br /><strong>CRONOMETRISTI</strong></div>
            </div>
        </header>

        <div class="shootout-phase-pill">RIGORI</div>
        <div class="shootout-pre-match-score">GARA FINO AI RIGORI: @Game.State.ScoreA.ToString("00") - @Game.State.ScoreB.ToString("00")</div>

        <main class="shootout-layout">
            <section class="shootout-team-side home-shootout-side">
                <TeamPanel Team="A" Title="CASA" />
            </section>

            <section class="shootout-center-panel">
                <div class="shootout-center-heading">
                    <span class="shootout-goal-icon">▦</span>
                    <span>@(Game.State.ShootoutPhase == 2 ? "MORTE IMPROVVISA · SERIE UFFICIALE DEI RIGORI" : "SERIE UFFICIALE DEI RIGORI")</span>
                    <small>SERIE DEI 5 RIGORI</small>
                    <b class="shootout-current-team">Tira: @(Game.ShootoutCurrentTeam == "A" ? "CASA" : "OSPITI")</b>
                </div>
                <div class="shootout-actions">
                    <button type="button" class="shootout-undo" @onclick="UndoEvent" disabled="@(!Game.CanUndo)">↩ UNDO</button>
                    <button type="button" class="shootout-save" @onclick="SaveGame">▣ SALVA</button>
                    @if (Game.State.ShootoutFinished)
                    {
                        <button type="button" class="shootout-referto" @onclick="PrintReferto">▣ REFERTO FIGH</button>
                    }
                </div>
                <div class="shootout-table-wrap">
                    <table class="shootout-table">
                        <thead>
                            <tr>
                                <th>T</th>
                                <th>N°</th>
                                <th>CASA</th>
                                <th>ESITO</th>
                                <th>ESITO</th>
                                <th>N°</th>
                                <th>OSPITI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pair in GetShootoutPairs().Where(x => x.Round <= 5))
                            {
                                <tr>
                                    <td class="shootout-round">@pair.Round</td>
                                    <td class="shootout-number">@(pair.Home?.Number ?? "")</td>
                                    <td class="shootout-player-name">@(string.IsNullOrWhiteSpace(pair.Home?.PlayerName) ? "" : pair.Home.PlayerName)</td>
                                    <td class="shootout-result">@(pair.Home is null ? "" : (pair.Home.Goal ? "✓" : "×"))</td>
                                    <td class="shootout-result">@(pair.Away is null ? "" : (pair.Away.Goal ? "✓" : "×"))</td>
                                    <td class="shootout-number">@(pair.Away?.Number ?? "")</td>
                                    <td class="shootout-player-name">@(string.IsNullOrWhiteSpace(pair.Away?.PlayerName) ? "" : pair.Away.PlayerName)</td>
                                </tr>
                            }
                            @for (var i = GetShootoutPairs().Count(x => x.Round <= 5); i < 5; i++)
                            {
                                <tr class="shootout-empty-row"><td>@(i + 1)</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                            }
                            @if (GetShootoutPairs().Any(x => x.Round >= 6))
                            {
                                <tr class="shootout-sudden-separator"><td colspan="7"></td></tr>
                                @foreach (var pair in GetShootoutPairs().Where(x => x.Round >= 6))
                                {
                                    <tr>
                                        <td class="shootout-round">@pair.Round</td>
                                        <td class="shootout-number">@(pair.Home?.Number ?? "")</td>
                                        <td class="shootout-player-name">@(pair.Home?.PlayerName ?? "")</td>
                                        <td class="shootout-result">@(pair.Home is null ? "" : (pair.Home.Goal ? "✓" : "×"))</td>
                                        <td class="shootout-result">@(pair.Away is null ? "" : (pair.Away.Goal ? "✓" : "×"))</td>
                                        <td class="shootout-number">@(pair.Away?.Number ?? "")</td>
                                        <td class="shootout-player-name">@(pair.Away?.PlayerName ?? "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="shootout-help">| Barra Spaziatrice: Avvia / Ferma Cronometro |</div>
            </section>

            <section class="shootout-team-side away-shootout-side">
                <TeamPanel Team="B" Title="OSPITI" />
            </section>
        </main>

        <footer class="shootout-footer">
            <button type="button" class="shootout-back" @onclick="Game.BackToMatchAfterShootout" disabled="@(!Game.State.ShootoutFinished)">← TORNA ALLA GARA</button>
            <div class="shootout-footer-center">
                <strong>@(Game.State.ShootoutFinished ? "GARA TERMINATA" : $"SELEZIONA IL GIOCATORE DELLA SQUADRA {(Game.ShootoutCurrentTeam == "A" ? "CASA" : "OSPITI")} PER IL PROSSIMO TIRO")</strong>
                <small>@(Game.State.ShootoutFinished ? $"Serie finale: {Game.State.ShootoutScoreA:00} - {Game.State.ShootoutScoreB:00}" : "Chi ha già tirato resta escluso fino al completamento del giro di tutti gli eleggibili.")</small>
            </div>
            <button type="button" class="shootout-finish" @onclick="Game.OpenShootoutWinner" disabled="@(!Game.State.ShootoutFinished)">⚑ TERMINA SERIE RIGORI</button>
        </footer>
    }
    else
    {
        <header class="topbar">
            <div class="brand"><img src="images/FIGH.png" alt="FIGH" /><div><div class="federation">FEDERAZIONE ITALIANA GIUOCO HANDBALL</div><div class="app-title">REFERTO PALLAMANO</div></div></div>
            <div class="phase-box">@GameService.PhaseName(Game.State.Phase)</div>
        </header>

        <section class="scorebar">
            <div class="team-name-box home-team-name" style="--team-color:@Game.State.Casa.Color">@Game.State.Casa.Name</div>
            <div class="team-points-box home-team-points" style="--team-color:@Game.State.Casa.Color">@Game.State.ScoreA</div>
            <div class="clock-area timer-yellow-panel">
                <div class="clock-adjust-row">
                    <button type="button" class="clock-adjust clock-minus" @onclick='() => Game.AdjustTimer(-1)'>−1</button>
                    <button type="button" class="clock @(Game.State.Running ? "clock-running" : "clock-stopped")" @onclick="OpenTimerEditor" disabled="@Game.State.Running" title="A cronometro fermo, clicca per modificare il tempo">
                        <span>@GameService.FormatTime(Game.State.TimerSeconds)</span><span class="clock-edit-icon">✎</span>
                    </button>
                    <button type="button" class="clock-adjust clock-plus" @onclick='() => Game.AdjustTimer(1)'>+1</button>
                </div>

                @if (Game.State.TimeoutRemainingSeconds > 0)
                {
                    <div class="match-timeout-countdown">TIME OUT @(Game.State.TimeoutTeam == "A" ? Game.State.Casa.Name : Game.State.Ospiti.Name) · @GameService.FormatTime(Game.State.TimeoutRemainingSeconds)</div>
                }
                <div class="timer-command-card">
                    <div class="timer-command-row">
                        <button type="button" class="event-button cancel timer-command-button" @onclick="CancelEvent" disabled="@(Game.PendingEvent is null)">ANNULLA</button>
                        <button type="button" class="primary start-button timer-command-button @(Game.State.Running ? "stop-active" : "start-active")" @onclick="Game.StartStop">@(Game.State.Running ? "STOP" : "START")</button>
                        <button type="button" class="event-button undo timer-command-button" @onclick="UndoEvent" disabled="@(!Game.CanUndo)">UNDO</button>
                    </div>
                </div>

            </div>
            <div class="team-points-box away-team-points" style="--team-color:@Game.State.Ospiti.Color">@Game.State.ScoreB</div>
            <div class="team-name-box away-team-name" style="--team-color:@Game.State.Ospiti.Color">@Game.State.Ospiti.Name</div>
        </section>

        <main class="three-columns">
            <section class="side-team-column home-side-column" aria-label="CASA">
                <div class="team-event-zone">
                    <div class="team-event-grid">
                        @foreach (var e in EventTypes) { <button type="button" class="event-button @e.Css @(Game.PendingEvent?.Type == e.Code ? "selected" : "")" @onclick="() => SelectEvent(e.Code)">@e.Label</button> }
                        @if (Game.State.ControlloPossessoTimeOut)
                        {
                            <button type="button" class="event-button possession-button @(Game.State.PossessionTeam == "A" ? "possession-active" : "")" @onclick='() => Game.SetPossessionTeam("A")' disabled="@(Game.State.TimeoutRemainingSeconds > 0)" title="Segna che la squadra di casa è in possesso della palla">PALLA</button>
                        }
                        <button type="button" class="event-button timeout" @onclick='() => RegisterTimeout("A")' disabled="@(!Game.CanRequestTimeout("A"))" title="@Game.TimeoutAvailability("A")">TIME OUT</button>
                    </div>
                </div>
                <TeamPanel Team="A" Title="CASA" />
            </section>
            <section class="log-panel">
                <div class="panel-title">REGISTRO GARA <span class="event-edit-hint">@(Game.CanEditEvents ? "· TOCCA UN EVENTO PER MODIFICARLO ANCHE A CRONOMETRO ATTIVO" : "")</span></div>
                <div class="event-list">
                    <div class="event-row event-header"><span>Tempo</span><span>Sq</span><span>N.</span><span>Evento</span><strong>Ris.</strong></div>
                    @for (var displayIndex = Game.State.Events.Count - 1; displayIndex >= 0; displayIndex--)
                    {
                        // Copia locale indispensabile: il callback Blazor deve catturare
                        // l'indice della singola riga e non la variabile del ciclo for.
                        var eventIndex = displayIndex;
                        var ev = Game.State.Events[eventIndex];
                        <button type="button" class="event-row event-row-button @(ev.Type == "SYSTEM" ? "system-row" : "")" style="--event-team-color:@GetEventTeamColor(ev.Team)" disabled="@(ev.Type == "SYSTEM")" @onclick="() => OpenEventEditor(eventIndex)" title="@(Game.CanEditEvents && ev.Type != "SYSTEM" ? "Modifica evento" : "")">
                            <span class="event-time">@ev.Time</span><span class="event-team-cell">@ev.Team</span><span class="event-number">@(ev.Number == "—" ? "" : ev.Number)</span><span class="event-description">@ev.Text</span><strong class="event-result">@ev.Result</strong>
                        </button>
                    }
                    @if (Game.State.Events.Count == 0) { <div class="empty-log">Nessun evento registrato</div> }
                </div>
            </section>
            <section class="side-team-column away-side-column" aria-label="OSPITI">
                <div class="team-event-zone">


<div class="team-event-grid">
                        @foreach (var e in EventTypes) { <button type="button" class="event-button @e.Css @(Game.PendingEvent?.Type == e.Code ? "selected" : "")" @onclick="() => SelectEvent(e.Code)">@e.Label</button> }
                        @if (Game.State.ControlloPossessoTimeOut)
                        {
                            <button type="button" class="event-button possession-button @(Game.State.PossessionTeam == "B" ? "possession-active" : "")" @onclick='() => Game.SetPossessionTeam("B")' disabled="@(Game.State.TimeoutRemainingSeconds > 0)" title="Segna che la squadra ospite è in possesso della palla">PALLA</button>
                        }
                        <button type="button" class="event-button timeout" @onclick='() => RegisterTimeout("B")' disabled="@(!Game.CanRequestTimeout("B"))" title="@Game.TimeoutAvailability("B")">TIME OUT</button>
                    </div>
                </div>
                <TeamPanel Team="B" Title="OSPITI" />
            </section>
        </main>

        <footer class="bottom-bar">
            <button @onclick="SaveGame">💾 SALVA GARA</button><button @onclick="RestoreRecovery">↩ RIPRISTINA</button><button @onclick="LoadMatchData">📥 CARICA DATI GARA</button><button @onclick="PrintReferto">📄 REFERTO</button><button @onclick="Game.OpenConfiguration" disabled="@Game.State.MatchStarted">⚙ CONFIGURAZIONE</button><button @onclick="Game.FinishCurrentPeriod" disabled="@(Game.State.MatchFinished || Game.State.ShootoutStarted)">FINE PERIODO</button>        <div class="mini-timer-card mini-timer-toolbar">
            <div class="mini-timer-label">CRONOMETRO</div>
            <div class="mini-timer-display">@GameService.FormatTime(Game.GetMiniTimerSeconds())</div>
        </div>
@if (Game.State.MatchFinished)
        {
            <button type="button" class="status game-finished-close" @onclick="ExitApplication" title="Chiudi il progetto">GARA TERMINATA</button>
        }
        else
        {
            <span class="status">@(Game.State.Running ? "CRONOMETRO ATTIVO" : "PRONTA / FERMA")</span>
        }
        </footer>
    }
</div>

@if (Game.ShowConfiguration)
{
    <div class="overlay config-overlay">
        <div class="config-card ipad11-config-card">
            <div class="config-main-title"><span aria-hidden="true">⚙</span> CONFIGURAZIONE GARA</div>
            <div class="config-topbar">
                <div class="config-duration-top">
                    <strong>DURATA DI OGNI TEMPO</strong>
                    <input class="duration-input" type="number" min="1" max="60" @bind="Game.State.HalfDurationMinutes" />
                    <span>MINUTI</span>
                </div>
                <div class="config-duration-top config-overtime-top">
                    <strong>DURATA SUPPLEMENTARI</strong>
                    <input class="duration-input" type="number" min="1" max="15" @bind="Game.State.OvertimeDurationMinutes" />
                    <span>MINUTI</span>
                </div>
                <div class="config-checks-top">
                    <label class="config-check-option"><input type="checkbox" @bind="Game.State.CronometroContinuativo" /><span>CRONOMETRO PALAZZETTO CONTINUATIVO</span></label>
                </div>
                <div class="config-checks-top config-print-top">
                    <label class="config-check-option"><input type="checkbox" @bind="Game.State.RichiediCartellinoEsclusione" /><span>STAMPA CARTELLINO</span></label>
                    <label class="config-check-option" title="Se disattivato, l’operatore verifica manualmente il possesso; restano attivi i limiti FIGH sui time-out."><input type="checkbox" @bind="Game.State.ControlloPossessoTimeOut" /><span>CONTROLLO POSSESSO TIME OUT</span></label>
                </div>
            </div>

            <div class="config-main-columns">
                

                <section class="config-center-team">
                    <div class="config-details-grid">
                        <div class="match-main-info-row">
                            <label class="match-number-field">NUMERO GARA<input @bind="Game.State.MatchNumber" @bind:event="oninput" /></label>
                            <label class="championship-field">CAMPIONATO<input @bind="Game.State.Championship" @bind:event="oninput" /></label>
                            <label class="match-date-field">DATA<input type="date" value="@Game.State.MatchDate" @oninput="OnMatchDateInput" /></label>
                            <label class="match-time-field">ORA INIZIO GARA<input type="time" value="@Game.State.MatchTime" @oninput="OnMatchTimeInput" /></label>
                            <label class="match-venue-field">IMPIANTO<input @bind="Game.State.Venue" @bind:event="oninput" /></label>
                            <label class="match-city-field">LOCALITÀ<input @bind="Game.State.City" @bind:event="oninput" /></label>
                        </div>
                        <div class="match-officials-row">
                            <label class="referee-field">ARBITRO 1<input @bind="Game.State.Referee1" @bind:event="oninput" /></label>
                            <label class="referee-field">ARBITRO 2<input @bind="Game.State.Referee2" @bind:event="oninput" /></label>
                            <label class="delegate-field">DELEGATO F.I.G.H. 1<input @bind="Game.State.Delegate1" @bind:event="oninput" /></label>
                            <label class="delegate-field">DELEGATO F.I.G.H. 2<input @bind="Game.State.Delegate2" @bind:event="oninput" /></label>
                        </div>
                    </div>
                    <div class="config-mode-heading">TIPO DI GARA</div>
                    <div class="config-mode-grid">
                        <button type="button" class="config-mode-card @(Game.State.MatchMode == "STANDARD" ? "selected" : "")" @onclick='() => SetMatchMode("STANDARD")'>
                            <span class="config-mode-checkbox">@(Game.State.MatchMode == "STANDARD" ? "✓" : "")</span>
                            <strong>PARTITA<br />STANDARD</strong><small>2 TEMPI</small>
                        </button>
                        <button type="button" class="config-mode-card @(Game.State.MatchMode == "SUPPLEMENTARI" ? "selected" : "")" @onclick='() => SetMatchMode("SUPPLEMENTARI")'>
                            <span class="config-mode-checkbox">@(Game.State.MatchMode == "SUPPLEMENTARI" ? "✓" : "")</span>
                            <strong>CON<br />SUPPLEMENTARI</strong><small>2 SUPP. + 2 SUPP. + TIRI RIGORI</small>
                        </button>
                        <button type="button" class="config-mode-card @(Game.State.MatchMode == "RIGORI" ? "selected" : "")" @onclick='() => SetMatchMode("RIGORI")'>
                            <span class="config-mode-checkbox">@(Game.State.MatchMode == "RIGORI" ? "✓" : "")</span>
                            <strong>CON<br />TIRI DI RIGORE</strong><small>DOPO IL 2° TEMPO</small>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Game.ValidationError)) { <div class="validation-error config-validation">@Game.ValidationError</div> }
                </section>

                
            </div>

            <div class="config-bottom-actions">
                <button type="button" class="config-back-action" @onclick="CloseConfigWithoutStarting">← TORNA AL REFERTO</button>
                <button type="button" class="config-save-action" @onclick="SaveConfiguration">▣ REFERTO GARA</button>
                <button type="button" class="config-manual-action" @onclick="OpenManualConfiguration">✎ CONFIGURAZIONE SQUADRE</button>
                <button type="button" class="config-reset-action" @onclick="Game.Reset">↻ RESET</button>
                <button type="button" class="config-exit-action" @onclick="ExitApplication">⇱ ESCI</button>
            </div>
            <div class="config-footnote"><span>ⓘ</span> I giocatori e i dirigenti senza numero/lettera (campo vuoto) non saranno inclusi nel referto di gara e non potranno essere selezionati durante la partita.</div>
        </div>
    </div>
}

@if (ShowManualConfiguration)
{
    <div class="overlay manual-config-overlay">
        <section class="manual-config-dialog" role="dialog" aria-modal="true" aria-labelledby="manual-config-title">
            <header class="manual-config-header">
                <div>
                    <span class="manual-config-eyebrow">REFerto Pallamano · F.I.G.H.</span>
                    <h2 id="manual-config-title">Configurazione manuale delle squadre</h2>
                    <p>Inserisci le rose e i dirigenti delle due squadre.</p>
                </div>
                <button type="button" class="manual-config-close" aria-label="Chiudi configurazione manuale delle squadre" @onclick="CloseManualConfiguration">×</button>
            </header>
            <div class="manual-config-content">
                <div class="manual-teams-grid">
                    <section class="manual-team-card manual-team-home" style="--manual-team-color:@Game.State.Casa.Color;--manual-team-text:@GetContrastTextColor(Game.State.Casa.Color)">
                        <header><span class="manual-team-dot"></span><div><h3>Squadra di casa</h3><p>Inserisci numero di maglia e nome dei giocatori.</p></div></header>
                        <label class="manual-team-name">Nome squadra<input @bind="Game.State.Casa.Name" @bind:event="oninput" placeholder="Squadra di casa" /></label>
                        <h4 class="manual-section-label">Giocatori <span>(max 16)</span></h4>
                        <div class="manual-player-cards">
                        @for (var i = 0; i < 16; i++) { var ix = i;
                            <article class="manual-player-card">
                                <div class="manual-player-card-top manual-player-inline-row">
                                    <input class="manual-player-number" type="text" inputmode="numeric" maxlength="2" value='@GetNumberLabel("A", ix)' @oninput='e => SetNumberLabel("A", ix, e.Value?.ToString())' aria-label="Numero giocatore casa @(ix + 1)" />
                                    <input class="manual-player-name manual-player-name-inline" @bind="Game.State.Casa.PlayerNames[ix]" @bind:event="oninput" placeholder="Nome giocatore" aria-label="Nome giocatore casa @(ix + 1)" />
                                    <button type="button" class="manual-card-clear" title="Svuota giocatore @(ix + 1)" aria-label="Svuota giocatore casa @(ix + 1)" @onclick='() => ClearPlayer("A", ix)'>×</button>
                                </div>
                            </article>
                        }
                        </div>
                        <h4 class="manual-section-label">Dirigenti</h4>
                        <div class="manual-staff-cards">
                        @for (var i = 0; i < 5; i++) { var ix = i;
                            <article class="manual-staff-card">
                                <div class="manual-player-card-top"><input class="manual-player-number manual-staff-letter" maxlength="1" value='@(Game.State.Casa.StaffLetters[ix] ?? "")' @oninput='e => SetStaffLetter("A", ix, e.Value?.ToString())' aria-label="Lettera dirigente casa @(ix + 1)" /><button type="button" class="manual-card-clear" title="Svuota dirigente @(ix + 1)" aria-label="Svuota dirigente casa @(ix + 1)" @onclick='() => ClearStaff("A", ix)'>×</button></div>
                                <input class="manual-player-name" @bind="Game.State.Casa.StaffNames[ix]" @bind:event="oninput" placeholder="Nome" aria-label="Nome dirigente casa @(ix + 1)" />
                            </article>
                        }
                        </div>
                        <div class="manual-color-box">
                            <strong>COLORE CASA</strong>
                            <div class="manual-color-palette">
                                @foreach (var c in TeamColors)
                                {
                                    <button type="button" title="@c.Name" aria-label="Colore squadra di casa @c.Name" class="manual-color-swatch @(Game.State.Casa.Color == c.Hex ? "selected" : "")" style="background:@c.Hex" @onclick='() => SetTeamColor("A", c.Hex)'></button>
                                }
                            </div>
                        </div>
                    </section>
                    <section class="manual-team-card manual-team-away" style="--manual-team-color:@Game.State.Ospiti.Color;--manual-team-text:@GetContrastTextColor(Game.State.Ospiti.Color)">
                        <header><span class="manual-team-dot"></span><div><h3>Squadra ospite</h3><p>Inserisci numero di maglia e nome dei giocatori.</p></div></header>
                        <label class="manual-team-name">Nome squadra<input @bind="Game.State.Ospiti.Name" @bind:event="oninput" placeholder="Squadra ospite" /></label>
                        <h4 class="manual-section-label">Giocatori <span>(max 16)</span></h4>
                        <div class="manual-player-cards">
                        @for (var i = 0; i < 16; i++) { var ix = i;
                            <article class="manual-player-card">
                                <div class="manual-player-card-top manual-player-inline-row">
                                    <input class="manual-player-number" type="text" inputmode="numeric" maxlength="2" value='@GetNumberLabel("B", ix)' @oninput='e => SetNumberLabel("B", ix, e.Value?.ToString())' aria-label="Numero giocatore ospite @(ix + 1)" />
                                    <input class="manual-player-name manual-player-name-inline" @bind="Game.State.Ospiti.PlayerNames[ix]" @bind:event="oninput" placeholder="Nome giocatore" aria-label="Nome giocatore ospite @(ix + 1)" />
                                    <button type="button" class="manual-card-clear" title="Svuota giocatore @(ix + 1)" aria-label="Svuota giocatore ospite @(ix + 1)" @onclick='() => ClearPlayer("B", ix)'>×</button>
                                </div>
                            </article>
                        }
                        </div>
                        <h4 class="manual-section-label">Dirigenti</h4>
                        <div class="manual-staff-cards">
                        @for (var i = 0; i < 5; i++) { var ix = i;
                            <article class="manual-staff-card">

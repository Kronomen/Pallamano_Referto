@code {
    private static readonly (string Name, string Hex)[] TeamColors = [
        ("BLU", "#2563eb"), ("VIOLA", "#7c3aed"), ("VERDE", "#16a34a"),
        ("ARANCIONE", "#ea580c"), ("NERO", "#111827"),
        ("GIALLO", "#eab308")
    ];

    private string GetNumberLabel(string team, int index)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        return roster.NumberLabels is { Length: 16 } ? (roster.NumberLabels[index] ?? string.Empty) : string.Empty;
    }

    private IEnumerable<(int Round, ShootoutAttempt? Home, ShootoutAttempt? Away)> GetShootoutPairs()
    {
        var attempts = (Game.State.Shootout ?? []).OrderBy(x => x.Round).ToList();
        var maxRound = attempts.Count == 0 ? 0 : (attempts.Max(x => x.Round) + 1) / 2;
        for (var round = 1; round <= maxRound; round++)
        {
            var home = attempts.FirstOrDefault(x => x.Round == (round * 2 - 1) && x.Team == "A")
                       ?? attempts.FirstOrDefault(x => x.Round == (round * 2) && x.Team == "A");
            var away = attempts.FirstOrDefault(x => x.Round == (round * 2 - 1) && x.Team == "B")
                       ?? attempts.FirstOrDefault(x => x.Round == (round * 2) && x.Team == "B");
            yield return (round, home, away);
        }
    }

    private void SetNumberLabel(string team, int index, string? value)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        value = (value ?? string.Empty).Trim();
        if (value.Length > 2 || value.Any(c => !char.IsDigit(c))) return;
        roster.NumberLabels[index] = value;
        roster.Numbers[index] = int.TryParse(value, out var n) ? n : -1;
        roster.ActivePlayers[index] = !string.IsNullOrWhiteSpace(value);
    }

    private void SetStaffLetter(string team, int index, string? value)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        value = (value ?? string.Empty).Trim().ToUpperInvariant();
        if (value.Length > 1 || (!string.IsNullOrWhiteSpace(value) && value is not ("A" or "B" or "C" or "D" or "E"))) return;
        roster.StaffLetters[index] = value;
        roster.ActiveStaff[index] = !string.IsNullOrWhiteSpace(value);
    }

    private void ClearPlayer(string team, int index)
    {
        SetNumberLabel(team, index, string.Empty);
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        roster.PlayerNames[index] = string.Empty;
    }

    private void ClearStaff(string team, int index)
    {
        SetStaffLetter(team, index, string.Empty);
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        roster.StaffNames[index] = string.Empty;
    }

    private bool IsPlayerConfigured(string team, int index) =>
        (team == "A" ? Game.State.Casa : Game.State.Ospiti).NumberLabels[index].Trim().Length > 0;

    private bool IsStaffConfigured(string team, int index) =>
        !string.IsNullOrWhiteSpace((team == "A" ? Game.State.Casa : Game.State.Ospiti).StaffLetters[index]);

    private async Task ExitApplication()
    {
        try { await JS.InvokeVoidAsync("chiudiApplicazione"); } catch { }
    }

    private void CloseConfigWithoutStarting() => Game.CloseConfigurationWithoutStarting();

    private static double NumberSortKey(string? label, int fallback)
    {
        var v = (label ?? string.Empty).Trim();
        if (v == "0") return 0;
        if (v == "00") return 0.5;
        if (int.TryParse(v, out var n) && n >= 1) return n;
        return fallback >= 1 ? fallback : 9999;
    }

    private void SetTeamColor(string team, string color) => Game.SetTeamColor(team, color);

    private void SetMatchMode(string mode)
    {
        if (mode is "STANDARD" or "SUPPLEMENTARI" or "RIGORI")
            Game.State.MatchMode = mode;
    }

    private static string GetContrastTextColor(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#ffffff";
        var h = hex.Trim().TrimStart('#');
        if (h.Length == 3) h = string.Concat(h.Select(c => new string(c, 2)));
        if (h.Length != 6) return "#ffffff";
        if (!int.TryParse(h.Substring(0, 2), System.Globalization.NumberStyles.HexNumber, null, out var r) ||
            !int.TryParse(h.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out var g) ||
            !int.TryParse(h.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out var b)) return "#ffffff";
        return (0.299 * r + 0.587 * g + 0.114 * b) >= 160 ? "#111827" : "#ffffff";
    }

    private readonly (string Code, string Label, string Css)[] EventTypes = [
        ("GOAL", "GOAL", "goal"),
        ("PENALTY_GOAL", "7m GOAL", "penalty-goal"),
        ("PENALTY_MISS", "7m MISS", "penalty-miss"),
        ("YELLOW", "AMMONIZIONE", "yellow"),
        ("TWO", "2'", "two"),
        ("RED", "ESPULSIONE DIRETTA", "red")];

    protected override void OnInitialized()
    {
        Game.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _ = InvokeAsync(StateHasChanged);
        // Il recovery viene scritto immediatamente a ogni modifica reale
        // della gara, non soltanto dopo un render della pagina.
        _ = SaveRecoveryIfReady();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Leggiamo prima il recovery esistente. L'app non deve mai
            // sovrascriverlo all'avvio con una gara vuota.
            var existingRecovery = await JS.InvokeAsync<string?>("recuperaPartitaLocale");
            // IMPORTANTISSIMO: all'avvio il recovery può contenere una gara
            // precedente. Non deve essere sovrascritto dalla GameState vuota.
            // Il confronto parte dallo stato appena creato e il primo autosave
            // avviene soltanto quando lo stato cambia realmente.
            _lastRecoveryJson = Game.ExportJson();
            _recoveryReady = true;
            _recoveryAvailable = !string.IsNullOrWhiteSpace(existingRecovery);

            // Il recovery viene registrato autonomamente anche quando
            // l'utente modifica campi della distinta/configurazione che
            // non passano da Game.Notify(), e durante il trascorrere del
            // cronometro.
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("avviaAutoRecovery", _selfRef);
        }
    }

    private async Task SaveRecoveryIfReady()
    {
        if (!_recoveryReady) return;
        try
        {
            var json = Game.ExportJson();
            if (!string.Equals(json, _lastRecoveryJson, StringComparison.Ordinal))
            {
                await JS.InvokeVoidAsync("salvaPartitaLocale", json);
                _lastRecoveryJson = json;
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private bool _timerEditorOpen;
    private string _timerEditValue = "00:00";
    private string _timerEditorError = "";

    private bool _eventEditorOpen;
    private int? _editingEvent;
    private string _editTime = "00:00";
    private string _editTeam = "A";
    private string _editNumber = "";
    private string _editType = "GOAL";
    private string _eventEditorError = "";

    private IEnumerable<(string Value, string Label)> GetEditorParticipants(string team)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        for (var i = 0; i < 16; i++)
        {
            if (!roster.ActivePlayers[i]) continue;
            var n = GetNumberLabel(team, i).Trim();
            if (string.IsNullOrWhiteSpace(n)) continue;
            yield return (n, $"{n} - {roster.PlayerNames[i]}");
        }
        for (var i = 0; i < 5; i++)
        {
            if (!roster.ActiveStaff[i]) continue;
            var l = roster.StaffLetters[i];
            yield return (l, $"{l} - {roster.StaffNames[i]}");
        }
    }

    private void OpenTimerEditor()
    {
        if (!Game.CanEditEvents) return;
        _timerEditValue = GameService.FormatTime(Game.State.TimerSeconds);
        _timerEditorError = "";
        _timerEditorOpen = true;
        StateHasChanged();
    }

    private void CloseTimerEditor()
    {
        _timerEditorOpen = false;
        _timerEditorError = "";
    }

    private void SaveTimerEditor()
    {
        var value = (_timerEditValue ?? "").Trim();
        var parts = value.Split(':');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var minutes) || !int.TryParse(parts[1], out var seconds) || seconds < 0 || seconds > 59 || minutes < 0)
        {
            _timerEditorError = "Inserisci un tempo valido nel formato MM:SS.";
            return;
        }

        var normalized = $"{minutes:00}:{seconds:00}";
        if (!Game.EditTimer(normalized))
        {
            _timerEditorError = $"Il tempo deve essere compreso tra {GameService.FormatTime(Game.GetPeriodStartSeconds(Game.State.Phase))} e {GameService.FormatTime(Game.GetCurrentPeriodEndSeconds())}.";
            return;
        }

        CloseTimerEditor();
    }

    private void OpenEventEditor(int index)
    {
        // La modifica del Registro Gara è volutamente possibile SOLO a cronometro fermo.
        // In questo modo l'operatore non può alterare un evento mentre il tempo ufficiale
        // sta scorrendo. Al tocco di una riga viene aperta una vera finestra di modifica,
        // come nel precedente referto HTML.
        if (!Game.CanEditEvents) return;
        if (index < 0 || index >= Game.State.Events.Count) return;

        var ev = Game.State.Events[index];
        if (ev.Type == "SYSTEM" || ev.Type is "SHOOTOUT_GOAL" or "SHOOTOUT_MISS") return;

        _editingEvent = index;
        _editTime = ev.Time;
        _editTeam = ev.Team is "A" or "B" ? ev.Team : "A";
        _editNumber = ev.Number == "—" ? "" : ev.Number;
        _editType = ev.Type switch
        {
            "TIMEOUT" or "T.O." or "TO" => "TIMEOUT",
            "GOAL" => "GOAL",
            "PENALTY_GOAL" => "PENALTY_GOAL",
            "PENALTY_MISS" => "PENALTY_MISS",
            "YELLOW" => "YELLOW",
            "TWO" => "TWO",
            "RED" => "RED",
            _ => "GOAL"
        };
        _eventEditorError = "";
        _eventEditorOpen = true;
        StateHasChanged();
    }

    private void RefreshEditorParticipants()
    {
        if (_editType == "TIMEOUT") { _editNumber = ""; return; }
        if (!GetEditorParticipants(_editTeam).Any(p => p.Value == _editNumber))
            _editNumber = GetEditorParticipants(_editTeam).Select(p => p.Value).FirstOrDefault() ?? "";
    }

    private void CloseEventEditor()
    {
        _eventEditorOpen = false;
        _editingEvent = null;
        _eventEditorError = "";
    }

    private void SaveEditingEvent()
    {
        if (_editingEvent is null) return;
        if (!Game.CanEditEvents)
        {
            _eventEditorError = "Il cronometro deve essere fermo per registrare la modifica.";
            return;
        }

        if (!Game.EditEvent(_editingEvent.Value, _editTime, _editTeam, _editNumber, _editType))
        {
            _eventEditorError = "Modifica non valida. Controlla tempo, squadra, numero/dirigente ed evento.";
            return;
        }

        // EditEvent salva uno snapshot prima della variazione e ricalcola automaticamente
        // risultato, reti, 7m, ammonizioni, 2', espulsioni e countdown.
        CloseEventEditor();
    }

    private void DeleteEditingEvent()
    {
        if (_editingEvent is null) return;
        if (!Game.DeleteEvent(_editingEvent.Value))
        {
            _eventEditorError = "L'evento non può essere eliminato in questo momento.";
            return;
        }
        CloseEventEditor();
    }

    private void SelectEvent(string code)
    {
        if (Game.State.MatchFinished || Game.State.ShootoutStarted) return;
        Game.SelectEvent(code);

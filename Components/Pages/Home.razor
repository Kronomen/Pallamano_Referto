@code {
    private bool ShowWhatsAppDialog { get; set; }
    private List<string> WhatsAppPhones { get; set; } = [""];
    private List<string> EmailRecipients { get; set; } = [""];
    private bool ShowManualConfiguration { get; set; }

    private void OpenManualConfiguration() => ShowManualConfiguration = true;
    private void CloseManualConfiguration() => ShowManualConfiguration = false;
    private async Task SaveManualConfiguration()
    {
        ShowManualConfiguration = false;
        await SaveRecoveryIfReady();
        StateHasChanged();
    }

    private void OpenWhatsAppDialog()
    {
        WhatsAppPhones = [""];
        EmailRecipients = [""];
        ShowWhatsAppDialog = true;
    }
    private void CloseWhatsAppDialog() => ShowWhatsAppDialog = false;
    private void AddWhatsAppPhone() { if (WhatsAppPhones.Count < 10) WhatsAppPhones.Add(""); }
    private void RemoveWhatsAppPhone(int index) { if (WhatsAppPhones.Count > 1 && index >= 0 && index < WhatsAppPhones.Count) WhatsAppPhones.RemoveAt(index); }
    private void AddEmailRecipient() { if (EmailRecipients.Count < 10) EmailRecipients.Add(""); }
    private void RemoveEmailRecipient(int index) { if (EmailRecipients.Count > 1 && index >= 0 && index < EmailRecipients.Count) EmailRecipients.RemoveAt(index); }
    private async Task ShareRefertoRecipients()
    {
        var phones = WhatsAppPhones.Select(x => new string((x ?? "").Where(char.IsDigit).ToArray())).Where(x => x.Length > 0).ToArray();
        var emails = EmailRecipients.Select(x => (x ?? "").Trim()).Where(x => x.Length > 0).ToArray();
        if (phones.Length == 0 && emails.Length == 0)
        {
            await JS.InvokeVoidAsync("alert", "Inserisci almeno un numero WhatsApp o un indirizzo email.");
            return;
        }
        if (phones.Any(x => x.Length < 8 || x.Length > 15))
        {
            await JS.InvokeVoidAsync("alert", "Controlla i numeri WhatsApp: inserisci il prefisso internazionale e un numero valido (8–15 cifre).");
            return;
        }
        if (emails.Length > 10 || emails.Any(x => !System.Net.Mail.MailAddress.TryCreate(x, out var address) || address.Address != x))
        {
            await JS.InvokeVoidAsync("alert", "Controlla gli indirizzi email inseriti: uno o più indirizzi non sono validi.");
            return;
        }
        if (phones.Length > 10) { await JS.InvokeVoidAsync("alert", "Puoi inserire al massimo 10 numeri WhatsApp."); return; }
        ShowWhatsAppDialog = false;
        await SendRefertoData(new { phones, emails });
    }
    private static readonly (string Name, string Hex)[] TeamColors = [
        ("BLU", "#2563eb"), ("VIOLA", "#7c3aed"), ("VERDE", "#16a34a"),
        ("ARANCIONE", "#ea580c"), ("NERO", "#111827"),
        ("GIALLO", "#eab308")
    ];

    private string GetNumberLabel(string team, int index)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        return roster.NumberLabels is { Length: 16 } ? (roster.NumberLabels[index] ?? string.Empty) : string.Empty;
    }

    private IEnumerable<(int Round, ShootoutAttempt? Home, ShootoutAttempt? Away)> GetShootoutPairs()
    {
        var attempts = (Game.State.Shootout ?? []).OrderBy(x => x.Round).ToList();
        var maxRound = attempts.Count == 0 ? 0 : (attempts.Max(x => x.Round) + 1) / 2;
        for (var round = 1; round <= maxRound; round++)
        {
            var home = attempts.FirstOrDefault(x => x.Round == (round * 2 - 1) && x.Team == "A")
                       ?? attempts.FirstOrDefault(x => x.Round == (round * 2) && x.Team == "A");
            var away = attempts.FirstOrDefault(x => x.Round == (round * 2 - 1) && x.Team == "B")
                       ?? attempts.FirstOrDefault(x => x.Round == (round * 2) && x.Team == "B");
            yield return (round, home, away);
        }
    }

    private void SetNumberLabel(string team, int index, string? value)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        value = (value ?? string.Empty).Trim();
        if (value.Length > 2 || value.Any(c => !char.IsDigit(c))) return;
        roster.NumberLabels[index] = value;
        roster.Numbers[index] = int.TryParse(value, out var n) ? n : -1;
        roster.ActivePlayers[index] = !string.IsNullOrWhiteSpace(value);
    }

    private void SetStaffLetter(string team, int index, string? value)
    {
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        value = (value ?? string.Empty).Trim().ToUpperInvariant();
        if (value.Length > 1 || (!string.IsNullOrWhiteSpace(value) && value is not ("A" or "B" or "C" or "D" or "E"))) return;
        roster.StaffLetters[index] = value;
        roster.ActiveStaff[index] = !string.IsNullOrWhiteSpace(value);
    }

    private void ClearPlayer(string team, int index)
    {
        SetNumberLabel(team, index, string.Empty);
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        roster.PlayerNames[index] = string.Empty;
    }

    private void ClearStaff(string team, int index)
    {
        SetStaffLetter(team, index, string.Empty);
        var roster = team == "A" ? Game.State.Casa : Game.State.Ospiti;
        roster.StaffNames[index] = string.Empty;
    }

    private bool IsPlayerConfigured(string team, int index) =>
        (team == "A" ? Game.State.Casa : Game.State.Ospiti).NumberLabels[index].Trim().Length > 0;

    private bool IsStaffConfigured(string team, int index) =>
        !string.IsNullOrWhiteSpace((team == "A" ? Game.State.Casa : Game.State.Ospiti).StaffLetters[index]);


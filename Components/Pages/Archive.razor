    private async Task AddTeam() { if (string.IsNullOrWhiteSpace(TeamName) || Archivio.Data.Teams.Any(x => ArchiveService.Same(x.Name, TeamName))) return; Archivio.Data.Teams.Add(new ArchiveTeam { Name = TeamName.Trim(), ShortName = TeamShortName.Trim() }); TeamName = TeamShortName = ""; await Archivio.SaveAsync(); }
    private async Task AddSeason() { if (string.IsNullOrWhiteSpace(SeasonName) || SeasonEnd < SeasonStart || Archivio.Data.Seasons.Any(x => ArchiveService.Same(x.Name, SeasonName))) return; Archivio.Data.Seasons.Add(new ArchiveSeason { Name = SeasonName.Trim(), StartDate = DateOnly.FromDateTime(SeasonStart), EndDate = DateOnly.FromDateTime(SeasonEnd) }); SeasonName = ""; await Archivio.SaveAsync(); }

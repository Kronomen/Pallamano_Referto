    private async Task ToggleTeam(string id) { var x = Archivio.Data.Teams.FirstOrDefault(x => x.Id == id); if (x is not null) { x.IsActive = !x.IsActive; await Archivio.SaveAsync(); } }
    private async Task AddTeamRegistration()
    {
        if (string.IsNullOrWhiteSpace(TeamRegistrationTeamId) || string.IsNullOrWhiteSpace(TeamRegistrationChampionshipId) || string.IsNullOrWhiteSpace(TeamRegistrationSeasonId)) return;
        if (Archivio.Data.TeamEntries.Any(x => x.TeamId == TeamRegistrationTeamId && x.ChampionshipId == TeamRegistrationChampionshipId && x.SeasonId == TeamRegistrationSeasonId && x.EntryType == "TEAM")) { ImportMessage = "La squadra risulta già iscritta a quel campionato e stagione."; return; }
        Archivio.Data.TeamEntries.Add(new ArchiveTeamEntry { TeamId = TeamRegistrationTeamId, ChampionshipId = TeamRegistrationChampionshipId, SeasonId = TeamRegistrationSeasonId, EntryType = "TEAM" });
        await Archivio.SaveAsync();
    }
    private async Task AddPerson() { if (string.IsNullOrWhiteSpace(PersonName) || Archivio.Data.People.Any(x => ArchiveService.Same(x.FullName, PersonName) && x.PersonType == PersonType)) return; Archivio.Data.People.Add(new ArchivePerson { FullName = PersonName.Trim(), PersonType = PersonType }); PersonName = ""; await Archivio.SaveAsync(); }
    private async Task TogglePerson(string id) { var x = Archivio.Data.People.FirstOrDefault(x => x.Id == id); if (x is not null) { x.IsActive = !x.IsActive; await Archivio.SaveAsync(); } }
    private async Task AddPersonEntry()
    {
        if (string.IsNullOrWhiteSpace(EntryPersonId) || string.IsNullOrWhiteSpace(EntryTeamId) || string.IsNullOrWhiteSpace(EntryChampionshipId) || string.IsNullOrWhiteSpace(EntrySeasonId)) return;
        var person = Archivio.Data.People.First(x => x.Id == EntryPersonId);
        var isPlayer = person.PersonType == "PLAYER";
        var value = EntryNumber.Trim().ToUpperInvariant();
        if (isPlayer && value.Length > 0 && !(value == "0" || value == "00" || (int.TryParse(value, out var n) && n >= 1 && n <= 99))) { ImportMessage = "Numero maglia non valido: usa 0, 00 oppure un numero da 1 a 99."; return; }
        if (!isPlayer && value.Length > 0 && !"ABCDE".Contains(value)) { ImportMessage = "Per i dirigenti utilizza una lettera da A a E."; return; }
        if (Archivio.Data.TeamEntries.Any(x => x.PersonId == EntryPersonId && x.TeamId == EntryTeamId && x.ChampionshipId == EntryChampionshipId && x.SeasonId == EntrySeasonId)) { ImportMessage = "La persona è già associata a questa squadra, campionato e stagione."; return; }
        Archivio.Data.TeamEntries.Add(new ArchiveTeamEntry { PersonId = EntryPersonId, TeamId = EntryTeamId, ChampionshipId = EntryChampionshipId, SeasonId = EntrySeasonId, EntryType = isPlayer ? "PLAYER" : "OFFICIAL", ShirtNumber = isPlayer ? value : "", OfficialLetter = isPlayer ? "" : value });
        EntryNumber = ""; await Archivio.SaveAsync();
    }

    private async Task ImportExcel(InputFileChangeEventArgs e)
    {
        ImportMessage = "Lettura del file in corso…";
        try
        {
            using var stream = e.File.OpenReadStream(15 * 1024 * 1024);
            using var ms = new MemoryStream(); await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var parsedJson = await JS.InvokeAsync<string>("archiveExcel.read", base64, e.File.Name);
            var import = JsonSerializer.Deserialize<ArchiveWorkbookImport>(parsedJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (import is null) { ImportMessage = "Il file non contiene dati importabili."; return; }
            await Archivio.ImportWorkbookAsync(import);
            ImportMessage = $"Importazione completata: {import.Championships.Count} campionati rilevati, {import.Teams.Count} squadre e {import.People.Count} nominativi letti dal file. Totale archivio: {Archivio.Data.Championships.Count} campionati, {Archivio.Data.Teams.Count} squadre, {Archivio.Data.People.Count} persone.";

        }
        catch (Exception ex) { ImportMessage = "Importazione non completata: " + ex.Message; }
    }
    private async Task ConnectCloud()

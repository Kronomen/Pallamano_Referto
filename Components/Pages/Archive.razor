    private List<DuplicatePlayerEnrollmentCleanup> BuildDuplicatePlayerEnrollments()
    {
        var result = new List<DuplicatePlayerEnrollmentCleanup>();
        var groups = Archivio.Data.TeamEntries
            .Where(x => x.IsActive && x.EntryType == "PLAYER" && !string.IsNullOrWhiteSpace(x.PersonId))
            .GroupBy(x => new { x.PersonId, x.SeasonId });
        foreach (var group in groups)
        {
            var teamGroups = group.GroupBy(x => x.TeamId).ToList();
            if (teamGroups.Count < 2) continue;
            var keepTeamId = teamGroups[0].Key;
            var person = Archivio.Data.People.FirstOrDefault(x => x.Id == group.Key.PersonId);
            var season = Archivio.Data.Seasons.FirstOrDefault(x => x.Id == group.Key.SeasonId);
            var removeTeamIds = teamGroups.Skip(1).Select(x => x.Key).ToList();
            result.Add(new DuplicatePlayerEnrollmentCleanup
            {
                PersonId = group.Key.PersonId,
                PersonName = person?.FullName ?? "Atleta non trovato",
                SeasonId = group.Key.SeasonId,
                SeasonName = season?.Name ?? "Stagione non trovata",
                KeepTeamId = keepTeamId,
                KeepTeamName = Archivio.Data.Teams.FirstOrDefault(x => x.Id == keepTeamId)?.Name ?? "Società non trovata",
                RemoveTeamIds = removeTeamIds,
                RemoveTeamNames = removeTeamIds.Select(id => Archivio.Data.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? "Società non trovata").ToList()
            });
        }
        return result;
    }

    private async Task DeactivateDuplicatePlayerEnrollments()
    {
        var duplicates = BuildDuplicatePlayerEnrollments();
        if (duplicates.Count == 0)
        {
            ImportMessage = "Non risultano atleti con più società attive nella stessa stagione.";
            return;
        }
        var count = duplicates.Sum(x => Archivio.Data.TeamEntries.Count(entry =>
            entry.IsActive && entry.EntryType == "PLAYER" && entry.PersonId == x.PersonId &&
            entry.SeasonId == x.SeasonId && x.RemoveTeamIds.Contains(entry.TeamId)));
        var summary = string.Join("\\n", duplicates.Select(x => $"{x.PersonName} ({x.SeasonName}): mantiene {x.KeepTeamName}; disattiva {string.Join(", ", x.RemoveTeamNames)}"));
        if (!await JS.InvokeAsync<bool>("confirm", $"Saranno disattivate {count} iscrizioni duplicate per {duplicates.Count} atleti.\\n\\n{summary}\\n\\nLa prima società registrata resterà attiva. Lo storico e i referti non verranno cancellati. Procedere?"))
            return;
        foreach (var duplicate in duplicates)
        {
            foreach (var entry in Archivio.Data.TeamEntries.Where(entry =>
                entry.IsActive && entry.EntryType == "PLAYER" && entry.PersonId == duplicate.PersonId &&
                entry.SeasonId == duplicate.SeasonId && duplicate.RemoveTeamIds.Contains(entry.TeamId)))
                entry.IsActive = false;
        }
        await Archivio.SaveAsync();
        ImportMessage = $"Pulizia completata: disattivate {count} iscrizioni duplicate per {duplicates.Count} atleti. Le prime società registrate sono rimaste attive.";
    }

    private async Task AddPersonEntry()
    {
        if (string.IsNullOrWhiteSpace(EntryPersonId) || string.IsNullOrWhiteSpace(EntryTeamId) || string.IsNullOrWhiteSpace(EntryChampionshipId) || string.IsNullOrWhiteSpace(EntrySeasonId)) return;
        var person = Archivio.Data.People.First(x => x.Id == EntryPersonId);
        var isPlayer = person.PersonType == "PLAYER";
        var value = EntryNumber.Trim().ToUpperInvariant();
        if (isPlayer && value.Length > 0 && !(value == "0" || value == "00" || (int.TryParse(value, out var n) && n >= 1 && n <= 99))) { ImportMessage = "Numero maglia non valido: usa 0, 00 oppure un numero da 1 a 99."; return; }
        if (!isPlayer && value.Length > 0 && !"ABCDE".Contains(value)) { ImportMessage = "Per i dirigenti utilizza una lettera da A a E."; return; }
        var existing = Archivio.Data.TeamEntries.FirstOrDefault(x => x.PersonId == EntryPersonId && x.TeamId == EntryTeamId && x.ChampionshipId == EntryChampionshipId && x.SeasonId == EntrySeasonId && x.EntryType == (isPlayer ? "PLAYER" : "OFFICIAL"));
        if (existing is not null) { ImportMessage = "La persona risulta già associata a questa squadra, campionato e stagione."; return; }
        var previous = Archivio.Data.TeamEntries.Where(x => x.PersonId == EntryPersonId).ToList();
        if (previous.Any(x => x.TeamId != EntryTeamId))
        {
            var oldTeams = string.Join(", ", previous.Where(x => x.TeamId != EntryTeamId)
                .Select(x => Archivio.Data.Teams.FirstOrDefault(t => t.Id == x.TeamId)?.Name ?? "Squadra non trovata").Distinct());
            if (!await JS.InvokeAsync<bool>("confirm", $"La persona è già associata a {oldTeams}. Vuoi trasferirla a {Archivio.Data.Teams.First(x => x.Id == EntryTeamId).Name}? Le precedenti società saranno sostituite.")) return;
            foreach (var oldEntry in previous) oldEntry.TeamId = EntryTeamId;
        }
        Archivio.Data.TeamEntries.Add(new ArchiveTeamEntry { PersonId = EntryPersonId, TeamId = EntryTeamId, ChampionshipId = EntryChampionshipId, SeasonId = EntrySeasonId, EntryType = isPlayer ? "PLAYER" : "OFFICIAL", ShirtNumber = isPlayer ? value : "", OfficialLetter = isPlayer ? "" : value });
        EntryNumber = ""; await Archivio.SaveAsync();
    }

    private string GetPdfPersonStatus(ArchivePdfRosterPerson row, string teamId, string championshipName, string seasonName)
    {
        if (string.IsNullOrWhiteSpace(row.Name) || string.IsNullOrWhiteSpace(teamId)) return "Da completare";
        var type = row.PersonType == "OFFICIAL" ? "OFFICIAL" : "PLAYER";
        var person = Archivio.Data.People.FirstOrDefault(p => ArchiveService.Same(p.FullName, row.Name) && p.PersonType == type);
        if (person is null) return "Nuova anagrafica";
        var championship = Archivio.Data.Championships.FirstOrDefault(x => ArchiveService.Same(x.Name, championshipName));
        var season = Archivio.Data.Seasons.FirstOrDefault(x => ArchiveService.Same(x.Name, seasonName));
        if (championship is null || season is null) return "Già in archivio";
        var entry = Archivio.Data.TeamEntries.FirstOrDefault(x => x.PersonId == person.Id && x.TeamId == teamId &&
            x.ChampionshipId == championship.Id && x.SeasonId == season.Id && x.EntryType == type);
        if (entry is not null)
        {
            var existing = type == "PLAYER" ? entry.ShirtNumber : entry.OfficialLetter;
            return string.IsNullOrWhiteSpace(existing) ? "Associazione presente: completa numero/lettera" :
                ArchiveService.Same(existing, row.NumberOrLetter) ? "Già presente e correttamente associato" : $"Numero/lettera già registrato: {existing}";
        }
        var elsewhere = Archivio.Data.TeamEntries.Any(x => x.PersonId == person.Id && x.ChampionshipId == championship.Id &&
            x.SeasonId == season.Id && x.EntryType == type && x.IsActive && x.TeamId != teamId);
        return elsewhere ? "Già attivo in un'altra società: non verrà duplicato" : "Persona presente: nuova associazione";
    }

    private async Task ImportPdfRoster(InputFileChangeEventArgs e)
    {
        PdfBusy = true; ImportMessage = ""; PdfRoster = null;
        try
        {
            using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream(); await stream.CopyToAsync(ms);
            var parsed = await JS.InvokeAsync<string>("archivePdf.read", Convert.ToBase64String(ms.ToArray()));
            PdfRoster = JsonSerializer.Deserialize<ArchivePdfRosterImport>(parsed, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (PdfRoster is null || PdfRoster.Teams.Count != 2 || PdfRoster.Teams.Any(t => t.People.Count == 0))
                throw new InvalidOperationException("Non sono state riconosciute entrambe le rose. Verifica che il PDF sia un referto FIGH leggibile.");
            foreach (var team in PdfRoster.Teams)
            {
                var match = Archivio.Data.Teams.FirstOrDefault(t => ArchiveService.Same(t.Name, team.DetectedName));
                if (match is not null) team.TeamId = match.Id;
            }
            PdfChampionship = Archivio.Data.Championships.FirstOrDefault(x => x.IsActive)?.Name ?? "";
            PdfSeason = Archivio.Data.Seasons.FirstOrDefault(x => x.IsActive)?.Name ?? "";
            ImportMessage = $"Anteprima pronta: {PdfRoster.Teams.Sum(t => t.People.Count(p => p.PersonType == "PLAYER"))} atleti e {PdfRoster.Teams.Sum(t => t.People.Count(p => p.PersonType == "OFFICIAL"))} dirigenti rilevati. Controlla nomi, numeri e società prima di importare.";
        }
        catch (Exception ex) { ImportMessage = "Lettura PDF non completata: " + ex.Message; PdfRoster = null; }
        finally { PdfBusy = false; }
    }

    private async Task ConfirmPdfRosterImport()
    {
        if (!CanImportPdfRoster || PdfRoster is null) return;
        var selected = PdfRoster.Teams.SelectMany(t => t.People).Count(p => p.Selected);
        if (!await JS.InvokeAsync<bool>("confirm", $"Confermi l'importazione di {selected} persone selezionate? Le persone già presenti verranno riutilizzate; nessuna iscrizione attiva in un'altra società verrà spostata automaticamente.")) return;
        try
        {
            PdfRoster.Championship = PdfChampionship;
            PdfRoster.Season = PdfSeason;\n            var result = await Archivio.ImportPdfRosterAsync(PdfRoster);
            ImportMessage = $"Importazione completata: {result.AddedPeople} nuove anagrafiche, {result.AddedEntries} nuove iscrizioni, {result.UpdatedEntries} associazioni completate. Elementi non modificati o da verificare: {result.Skipped}.";
            PdfRoster = null;
        }
        catch (Exception ex) { ImportMessage = "Importazione non completata: " + ex.Message; }
    }

    private void CancelPdfRoster() { PdfRoster = null; ImportMessage = "Anteprima annullata: nessun dato è stato modificato."; }

    private async Task ImportExcel(InputFileChangeEventArgs e)
    {
        ImportMessage = "Lettura del file in corso…";
        try
        {
            using var stream = e.File.OpenReadStream(15 * 1024 * 1024);
            using var ms = new MemoryStream(); await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var parsedJson = await JS.InvokeAsync<string>("archiveExcel.read", base64, e.File.Name);
            var import = JsonSerializer.Deserialize<ArchiveWorkbookImport>(parsedJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (import is null) { ImportMessage = "Il file non contiene dati importabili."; return; }
            await Archivio.ImportWorkbookAsync(import);
            ImportMessage = $"Importazione completata: {import.Championships.Count} campionati rilevati, {import.Teams.Count} squadre e {import.People.Count} nominativi letti dal file. Totale archivio: {Archivio.Data.Championships.Count} campionati, {Archivio.Data.Teams.Count} squadre, {Archivio.Data.People.Count} persone.";

        }
        catch (Exception ex) { ImportMessage = "Importazione non completata: " + ex.Message; }
    }

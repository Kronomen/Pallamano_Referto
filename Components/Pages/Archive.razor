                                                }
                                            }
                                        </div>
                                    }
                                }
                                <button class="archive-small" @onclick="LoadOperators" disabled="@CloudBusy">AGGIORNA ELENCO</button>
                                @if (!string.IsNullOrWhiteSpace(OperatorMessage)) { <div class="archive-message">@OperatorMessage</div> }
                            </div>
                        }
                        <button class="archive-small" @onclick="DisconnectCloud">ESCI DAL CLOUD</button>
                        @if (Cloud.HasRemoteArchive)
                        {
                            <button class="archive-primary" @onclick="DownloadCloudArchive" disabled="@(CloudBusy || Cloud.HasPendingChanges)">USA L'ARCHIVIO PRESENTE NEL CLOUD</button>
                        }
                        else
                        {
                            <button class="archive-primary" @onclick="UploadLocalArchive" disabled="@CloudBusy">CARICA NEL CLOUD L'ARCHIVIO DI QUESTO DISPOSITIVO</button>
                        }
                    }
                    else
                    {
                        <p><strong>Stato:</strong> @Cloud.Status</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(CloudMessage)) { <div class="archive-message">@CloudMessage</div> }
                </div>
                <div class="archive-note"><strong>Esporta archivio completo</strong><p>Scarica tutte le anagrafiche, le squadre, i campionati, le stagioni e le associazioni in un file JSON.</p><button class="archive-primary" @onclick="ExportBackup">ESPORTA ARCHIVIO JSON</button></div>
                <div class="archive-note"><strong>Importa archivio da file JSON</strong><p>La sostituzione crea prima una copia di sicurezza dell'archivio attuale. Seleziona un file JSON esportato da Referto Pallamano.</p><InputFile OnChange="ImportArchiveJson" accept=".json,application/json" /></div>
                <div class="archive-note"><strong>Ripristina ultima copia di sicurezza</strong><p>Ripristina la copia salvata automaticamente prima dell'ultima importazione.</p><button class="archive-small" @onclick="RestoreBackup">RIPRISTINA BACKUP</button></div>
                @if (!string.IsNullOrWhiteSpace(ImportMessage)) { <div class="archive-message">@ImportMessage</div> }
                <div class="archive-note"><strong>Attenzione</strong><p>L'archivio è memorizzato nel browser e nel dispositivo in uso. Per trasferirlo su un altro dispositivo, esporta il JSON e importalo anche lì. Il caricamento di una nuova versione del sito non aggiorna automaticamente i dati locali.</p></div>
            </section>
        }
        <footer class="archive-footer"><span>Archivio locale del browser · salvataggio automatico dopo le modifiche</span><button class="archive-small" @onclick="ExportBackup">ESPORTA ARCHIVIO JSON</button></footer>
    }
</div>

@code {
    private bool PdfReadBusy;
    private string PdfImportMessage = "";
    private string PdfChampionshipId = "";
    private string PdfSeason = "2026/2027";
    private string PdfTeamA = "";
    private string PdfTeamB = "";
    private List<PdfImportPerson> PdfPeople = new();
    private sealed class PdfImportPerson
    {
        public int TeamIndex { get; set; }
        public string Type { get; set; } = "PLAYER";
        public string Number { get; set; } = "";
        public string Letter { get; set; } = "";
        public string Name { get; set; } = "";
        public bool Selected { get; set; }
        public string Resolution { get; set; } = "";
        public string MatchedPersonId { get; set; } = "";
    }
    private List<ArchivePerson> PdfNameMatches(PdfImportPerson p) =>
        Archivio.Data.People.Where(x => x.PersonType == p.Type && NormalizePersonName(x.FullName) == NormalizePersonName(p.Name)).ToList();
    private ArchivePerson? FindPdfPerson(PdfImportPerson p) =>
        Archivio.Data.People.FirstOrDefault(x => x.PersonType == p.Type && NormalizePersonName(x.FullName) == NormalizePersonName(p.Name));
    private bool IsNewPdfPerson(PdfImportPerson p) => FindPdfPerson(p) is null;
    private List<ArchiveTeamEntry> PdfActiveRegistrations(PdfImportPerson p, string? personId = null)
    {
        var ids = personId is null ? PdfNameMatches(p).Select(x => x.Id).ToHashSet() : new HashSet<string> { personId };
        var championship = Archivio.Data.Championships.FirstOrDefault(x => x.Id == PdfChampionshipId);
        var season = Archivio.Data.Seasons.FirstOrDefault(x => ArchiveService.Same(x.Name, PdfSeason));
        if (championship is null || season is null) return new();
        return Archivio.Data.TeamEntries.Where(x => ids.Contains(x.PersonId) && x.ChampionshipId == championship.Id &&
            x.SeasonId == season.Id && x.EntryType == p.Type && x.IsActive).ToList();
    }
    private bool PdfHasConflict(PdfImportPerson p) => p.Type == "PLAYER" && PdfActiveRegistrations(p).Any(x =>
        !ArchiveService.Same(Archivio.Data.Teams.FirstOrDefault(t=>t.Id==x.TeamId)?.Name ?? "", p.TeamIndex==0 ? PdfTeamA : PdfTeamB));
    private bool IsNewPdfEntry(PdfImportPerson p)
    {
        var person = FindPdfPerson(p);
        if (person is null) return true;
        var championship = Archivio.Data.Championships.FirstOrDefault(x => x.Id == PdfChampionshipId);
        var season = Archivio.Data.Seasons.FirstOrDefault(x => ArchiveService.Same(x.Name, PdfSeason));
        var teamName = p.TeamIndex == 0 ? PdfTeamA : PdfTeamB;
        var team = Archivio.Data.Teams.FirstOrDefault(x => ArchiveService.Same(x.Name, teamName));
        if (championship is null || season is null || team is null) return true;
        return !Archivio.Data.TeamEntries.Any(x => x.PersonId == person.Id && x.TeamId == team.Id &&
            x.ChampionshipId == championship.Id && x.SeasonId == season.Id && x.EntryType == p.Type);
    }
    private string PdfEntryStatus(PdfImportPerson p) =>
        IsNewPdfPerson(p) ? "Nuova anagrafica + iscrizione" :
        IsNewPdfEntry(p) ? "Anagrafica esistente · nuova iscrizione" : "Iscrizione già presente";
    private static string NormalizePersonName(string? value)
    {
        var normalized = (value ?? "").Normalize(System.Text.NormalizationForm.FormD);
        var chars = normalized.Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark);
        return new string(chars.ToArray()).ToUpperInvariant().Where(char.IsLetterOrDigit).Aggregate("", (a, ch) => a + ch);
    }
    private async Task ReadFighPdf(InputFileChangeEventArgs e)
    {
        PdfReadBusy = true; PdfImportMessage = ""; PdfPeople.Clear();
        try
        {
            using var stream = e.File.OpenReadStream(12 * 1024 * 1024);
            using var ms = new MemoryStream(); await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var json = await JS.InvokeAsync<string>("fighPdfImport.read", base64);
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            PdfSeason = root.TryGetProperty("season", out var season) && !string.IsNullOrWhiteSpace(season.GetString()) ? season.GetString()! : "2026/2027";
            var teams = root.GetProperty("teams");
            PdfTeamA = teams.GetArrayLength()>0 ? teams[0].GetString() ?? "" : "";
            PdfTeamB = teams.GetArrayLength()>1 ? teams[1].GetString() ?? "" : "";
            foreach (var item in root.GetProperty("people").EnumerateArray())
            {
                var p = new PdfImportPerson {
                    TeamIndex = item.GetProperty("teamIndex").GetInt32(),
                    Type = item.GetProperty("type").GetString() ?? "PLAYER",
                    Number = item.GetProperty("number").GetString() ?? "",
                    Letter = item.GetProperty("letter").GetString() ?? "",
                    Name = item.GetProperty("name").GetString() ?? ""
                };
                var matches = PdfNameMatches(p);
                if (matches.Count == 1) p.MatchedPersonId = matches[0].Id;
                p.Resolution = matches.Count == 0 ? "NEW" : matches.Count > 1 ? "" : PdfHasConflict(p) ? "" : "REUSE";
                p.Selected = matches.Count == 0 || (matches.Count == 1 && !PdfHasConflict(p));
                PdfPeople.Add(p);
            }
            PdfImportMessage = "Estrazione completata. Controlla i nominativi e i nomi delle squadre prima dell'importazione.";
        }
        catch (Exception ex) { PdfImportMessage = "Lettura PDF non riuscita: " + ex.Message; }
        finally { PdfReadBusy = false; }
    }
    private async Task ConfirmPdfImport()
    {
        var championship = Archivio.Data.Championships.FirstOrDefault(x=>x.Id==PdfChampionshipId);
        if (championship is null) { PdfImportMessage = "Seleziona il campionato."; return; }
        if (string.IsNullOrWhiteSpace(PdfTeamA) || string.IsNullOrWhiteSpace(PdfTeamB) || string.IsNullOrWhiteSpace(PdfSeason))
        { PdfImportMessage = "Completa i nomi delle due squadre e la stagione."; return; }
        var selected = PdfPeople.Where(x=>x.Selected && (x.Type != "PLAYER" || x.Resolution != "SKIP")).ToList();
        if (selected.Any(x => x.Type == "PLAYER" && PdfNameMatches(x).Count > 0 &&
            (string.IsNullOrWhiteSpace(x.Resolution) || (x.Resolution != "NEW" && string.IsNullOrWhiteSpace(x.MatchedPersonId)))))
        { PdfImportMessage = "Risolvi tutti i possibili omonimi o conflitti prima di importare."; return; }
        if (selected.Count==0) { PdfImportMessage = "Non ci sono nuovi nominativi selezionati."; return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Verranno elaborate {selected.Count} righe selezionate. Le scelte di trasferimento disattiveranno la precedente iscrizione alla squadra. Continuare?")) return;
        try
        {
            var season = Archivio.Data.Seasons.FirstOrDefault(x=>ArchiveService.Same(x.Name,PdfSeason));
            if (season is null) { season = new ArchiveSeason { Name=PdfSeason.Trim() }; Archivio.Data.Seasons.Add(season); }
            var teamNames = new[] { PdfTeamA.Trim(), PdfTeamB.Trim() };
            var teams = new ArchiveTeam[2];
            for (var i=0;i<2;i++)
            {
                teams[i] = Archivio.Data.Teams.FirstOrDefault(x=>ArchiveService.Same(x.Name,teamNames[i]))!;
                if (teams[i] is null) { teams[i]=new ArchiveTeam { Name=teamNames[i] }; Archivio.Data.Teams.Add(teams[i]); }
                if (!Archivio.Data.TeamEntries.Any(x=>x.TeamId==teams[i].Id && x.ChampionshipId==championship.Id && x.SeasonId==season.Id && x.EntryType=="TEAM"))
                    Archivio.Data.TeamEntries.Add(new ArchiveTeamEntry { TeamId=teams[i].Id, ChampionshipId=championship.Id, SeasonId=season.Id, EntryType="TEAM" });
            }
            var addedPeople = 0;
            var addedEntries = 0;
            foreach (var p in selected)
            {
                // Riutilizza l'anagrafica se la persona esiste già: l'iscrizione alla squadra è distinta.
                ArchivePerson? person = null;
                if (p.Type == "PLAYER" && p.Resolution == "SKIP") continue;
                if (p.Type == "PLAYER" && p.Resolution == "NEW")
                {
                    person = new ArchivePerson { FullName=p.Name.Trim(), PersonType=p.Type };
                    Archivio.Data.People.Add(person);
                    addedPeople++;
                }
                else if (!string.IsNullOrWhiteSpace(p.MatchedPersonId))
                    person = Archivio.Data.People.FirstOrDefault(x => x.Id == p.MatchedPersonId);
                person ??= FindPdfPerson(p);
                if (person is null)
                {
                    person = new ArchivePerson { FullName=p.Name.Trim(), PersonType=p.Type };
                    Archivio.Data.People.Add(person);
                    addedPeople++;
                }
                var team = teams[p.TeamIndex];
                if (p.Type == "PLAYER" && p.Resolution == "TRANSFER")
                {
                    foreach (var oldEntry in PdfActiveRegistrations(p, person.Id))
                        oldEntry.IsActive = false;
                }
                var existingEntry = Archivio.Data.TeamEntries.FirstOrDefault(x =>
                    x.PersonId == person.Id && x.TeamId == team.Id &&
                    x.ChampionshipId == championship.Id && x.SeasonId == season.Id && x.EntryType == p.Type);
                if (existingEntry is null)
                {
                    Archivio.Data.TeamEntries.Add(new ArchiveTeamEntry {
                        TeamId=team.Id, ChampionshipId=championship.Id, SeasonId=season.Id,
                        PersonId=person.Id, EntryType=p.Type, ShirtNumber=p.Type=="PLAYER" ? p.Number : "",
                        OfficialLetter=p.Type=="OFFICIAL" ? p.Letter : ""
                    });
                    addedEntries++;
                }
            }
            await Archivio.SaveAsync();
            PdfImportMessage = $"Importazione completata: {addedPeople} nuove anagrafiche e {addedEntries} nuove iscrizioni alle squadre. Le persone già presenti sono state riutilizzate.";
            PdfPeople.Clear();
        }
        catch (Exception ex) { PdfImportMessage = "Importazione non completata: " + ex.Message; }
    }
    private void ClearPdfImport() { PdfPeople.Clear(); PdfImportMessage="Anteprima annullata."; }

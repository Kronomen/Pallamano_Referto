                                                        <span class="archive-status @(device.IsRevoked ? "off" : "on")">@(device.IsRevoked ? "REVOCATO" : "ATTIVO")</span>
                                                        @if (!device.IsRevoked)
                                                        {
                                                            <button class="archive-small danger" @onclick="() => RevokeOperatorDevice(device)">REVOCA</button>

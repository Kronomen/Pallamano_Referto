        if (active)
        {
            var conflicts = Archivio.Data.TeamEntries.Where(x => x.Id != entry.Id && x.PersonId == entry.PersonId &&
                x.SeasonId == entry.SeasonId && x.IsActive).ToList();
            if (conflicts.Count > 0)
            {
                var teamNames = string.Join(", ", conflicts.Select(x => Archivio.Data.Teams.FirstOrDefault(t => t.Id == x.TeamId)?.Name ?? "Squadra non trovata").Distinct());
                if (!await JS.InvokeAsync<bool>("confirm", $"Questa persona risulta già attiva in {teamNames} nella stessa stagione. Vuoi assegnarla a questa squadra e disattivare le altre associazioni attive?"))
                    return;
                foreach (var conflict in conflicts) conflict.IsActive = false;
            }
        }
        entry.IsActive = active;
        await Archivio.SaveAsync();
    }
    private async Task DeletePerson(string id)

@page "/archivio"
@implements IAsyncDisposable
@using System.Text.Json
@using RefertoPallamano_Blazor.Services
@inject ArchiveService Archivio
@inject CloudArchiveService Cloud
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Archivio - Referto Pallamano</PageTitle>

<div class="archive-app">
    <header class="archive-header">
        <div class="archive-brand"><img src="images/FIGH.png" alt="FIGH" /><div><strong>REFERTO PALLAMANO</strong><span>GESTIONE ARCHIVIO</span></div></div>
        <div class="archive-header-actions"><button class="archive-back" @onclick="BackToMatch">← CONFIGURAZIONE GARA</button>
            @if (IsLocalRunner) { <button type="button" class="archive-close-app" @onclick="CloseApplication" title="Arresta l’applicazione locale" aria-label="Chiudi applicazione">×</button> }</div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Archivio.LoadError))
    {
        <section class="archive-card import-card">
            <h1>Archivio locale non caricato</h1>
            <p>@Archivio.LoadError</p>
            <p><strong>Non cancellare i dati del browser e non reinstallare l'applicazione.</strong> Puoi tentare di esportare il contenuto locale originale prima di qualsiasi ripristino.</p>
            <button class="archive-primary" @onclick="ExportStoredArchive">ESPORTA CONTENUTO LOCALE PER RECUPERO</button>
            <button class="archive-small" @onclick="RetryArchiveLoad">RIPROVA CARICAMENTO</button>
        </section>
    }
    else if (!Archivio.IsLoaded)
    {
        <div class="archive-loading">Caricamento archivio…</div>
    }
    else
    {
        <section class="archive-intro">
            <div><span class="archive-eyebrow">MODULO GESTIONALE</span><h1>CAMPIONATI, SQUADRE E ATLETI</h1><p>Gestisci gli archivi in modo dinamico: puoi aggiungere campionati e squadre senza modificare il programma.</p></div>
            <div class="archive-stats"><div><b>@Archivio.Data.Championships.Count</b><span>Campionati</span></div><div><b>@Archivio.Data.Teams.Count</b><span>Squadre</span></div><div><b>@Archivio.Data.People.Count</b><span>Persone</span></div></div>
        </section>

        <nav class="archive-tabs">
            <button class="@(Tab == "campionati" ? "active" : "")" @onclick='() => SetTab("campionati")'>CAMPIONATI</button>
            <button class="@(Tab == "squadre" ? "active" : "")" @onclick='() => SetTab("squadre")'>SQUADRE</button>
            <button class="@(Tab == "stagioni" ? "active" : "")" @onclick='() => SetTab("stagioni")'>STAGIONI</button>
            <button class="@(Tab == "persone" ? "active" : "")" @onclick='() => SetTab("persone")'>ATLETI E DIRIGENTI</button>
            <button class="@(Tab == "pdf" ? "active" : "")" @onclick='() => SetTab("pdf")'>IMPORTA PDF FIGH</button>
            <button class="@(Tab == "importa" ? "active" : "")" @onclick='() => SetTab("importa")'>IMPORTA EXCEL</button>
            <button class="@(Tab == "gestione" ? "active" : "")" @onclick='() => SetTab("gestione")'>GESTIONE ARCHIVIO</button>
        </nav>

        @if (Tab == "campionati")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Elenco campionati</h2><p>I campionati sono dati configurabili, non opzioni fisse del programma.</p></div><span class="archive-count">@Archivio.Data.Championships.Count</span></div>
                <div class="archive-form-grid championship-form">
                    <label>Nome campionato
                        <input @bind="ChampionshipName" placeholder="Es. Serie A1 Femminile" />
                    </label>
                    <label>Categoria
                        <select @bind="ChampionshipCategory">
                            <option value="">Seleziona categoria</option>
                            <option value="Senior">Senior</option>
                            <option value="Junior">Junior</option>
                            <option value="Open">Open</option>
                        </select>
                    </label>
                    <label>Genere
                        <select @bind="ChampionshipGender">
                            <option value="">Non specificato</option>
                            <option>Femminile</option>
                            <option>Maschile</option>
                            <option>Misto</option>
                        </select>
                    </label>
                    <button class="archive-primary" @onclick="AddChampionship" disabled="@string.IsNullOrWhiteSpace(ChampionshipName)">+ AGGIUNGI CAMPIONATO</button>
                </div>
                @if (Archivio.Data.Championships.Count == 0) { <div class="archive-empty">Nessun campionato inserito. Puoi crearne uno qui sopra o importare il modello Excel.</div> }
                <div class="archive-list championship-grid">
                    @foreach (var c in Archivio.Data.Championships.OrderBy(x => x.Name))
                    {
                        <div class="archive-list-row championship-row"><div class="archive-list-icon">🏆</div><div class="archive-list-main"><strong>@c.Name</strong><small>@(string.IsNullOrWhiteSpace(c.Category) ? "Categoria non specificata" : c.Category) · @(string.IsNullOrWhiteSpace(c.Gender) ? "Genere non specificato" : c.Gender)</small></div><span class="archive-status @(c.IsActive ? "on" : "off")">@(c.IsActive ? "ATTIVO" : "ARCHIVIATO")</span><button class="archive-small" @onclick="() => ToggleChampionship(c.Id)">@(c.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small danger" @onclick="() => DeleteChampionship(c.Id)">ELIMINA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "squadre")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Squadre</h2><p>Una squadra può essere iscritta a campionati e stagioni differenti.</p></div><span class="archive-count">@Archivio.Data.Teams.Count</span></div>
                <div class="archive-form-grid">
                    <label>Denominazione squadra<input @bind="TeamName" placeholder="Nome squadra" /></label>
                    <label>Nome abbreviato<input @bind="TeamShortName" placeholder="Facoltativo" /></label>
                    <button class="archive-primary" @onclick="AddTeam">+ AGGIUNGI SQUADRA</button>
                </div>
                <div class="archive-form-grid registration-form">
                    <label>Squadra<select @bind="TeamRegistrationTeamId"><option value="">Seleziona squadra</option>@foreach (var x in Archivio.Data.Teams) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Campionato<select @bind="TeamRegistrationChampionshipId"><option value="">Seleziona campionato</option>@foreach (var x in Archivio.Data.Championships) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Stagione<select @bind="TeamRegistrationSeasonId"><option value="">Seleziona stagione</option>@foreach (var x in Archivio.Data.Seasons) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <button class="archive-primary" @onclick="AddTeamRegistration">ISCRIVI SQUADRA</button>
                </div>
                <div class="archive-list teams-grid">
                    @foreach (var t in Archivio.Data.Teams.OrderBy(x => x.Name))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">🏐</div><div class="archive-list-main"><strong>@t.Name</strong><small>@(string.IsNullOrWhiteSpace(t.ShortName) ? "Nessuna abbreviazione" : t.ShortName) · @Archivio.Data.TeamEntries.Count(x => x.TeamId == t.Id && x.EntryType == "TEAM") iscrizioni</small></div><span class="archive-status @(t.IsActive ? "on" : "off")">@(t.IsActive ? "ATTIVA" : "ARCHIVIATA")</span><button class="archive-small" @onclick="() => ToggleTeam(t.Id)">@(t.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small danger" @onclick="() => DeleteTeam(t.Id)">ELIMINA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "stagioni")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Stagioni sportive</h2><p>Ogni iscrizione e ogni rosa sono collegate a una stagione specifica.</p></div><span class="archive-count">@Archivio.Data.Seasons.Count</span></div>
                <div class="archive-form-grid season-form">
                    <label>Nome stagione<input @bind="SeasonName" placeholder="Es. 2027/2028" /></label>
                    <label>Data inizio<input type="date" @bind="SeasonStart" /></label>
                    <label>Data fine<input type="date" @bind="SeasonEnd" /></label>
                    <button class="archive-primary" @onclick="AddSeason">+ AGGIUNGI STAGIONE</button>
                </div>
                <div class="archive-list">
                    @foreach (var season in Archivio.Data.Seasons.OrderByDescending(x => x.Name))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">📅</div><div class="archive-list-main"><strong>@season.Name</strong><small>@season.StartDate.ToString("dd/MM/yyyy") – @season.EndDate.ToString("dd/MM/yyyy") · @Archivio.Data.TeamEntries.Count(x => x.SeasonId == season.Id) associazioni</small></div><span class="archive-status @(season.IsActive ? "on" : "off")">@(season.IsActive ? "ATTIVA" : "ARCHIVIATA")</span><button class="archive-small" @onclick="() => ToggleSeason(season.Id)">@(season.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small danger" @onclick="() => DeleteSeason(season.Id)">ELIMINA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "persone")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Anagrafica atleti e dirigenti</h2><p>Il numero di maglia e la lettera del dirigente appartengono all'iscrizione stagionale, non alla persona.</p></div><span class="archive-count">@Archivio.Data.People.Count</span></div>
                <div class="archive-form-grid people-form">
                    <label>Nominativo<input @bind="PersonName" placeholder="Cognome e nome" /></label>
                    <label>Tipo<select @bind="PersonType"><option value="PLAYER">Atleta</option><option value="OFFICIAL">Dirigente</option></select></label>
                    <button class="archive-primary" @onclick="AddPerson">+ AGGIUNGI PERSONA</button>
                </div>
                <div class="archive-form-grid registration-form">
                    <label>Persona<select @bind="EntryPersonId"><option value="">Seleziona persona</option>@foreach (var x in Archivio.Data.People) { <option value="@x.Id">@x.FullName (@(x.PersonType == "PLAYER" ? "Atleta" : "Dirigente"))</option> }</select></label>
                    <label>Squadra<select @bind="EntryTeamId"><option value="">Seleziona squadra</option>@foreach (var x in Archivio.Data.Teams) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Campionato<select @bind="EntryChampionshipId"><option value="">Seleziona campionato</option>@foreach (var x in Archivio.Data.Championships) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Stagione<select @bind="EntrySeasonId"><option value="">Seleziona stagione</option>@foreach (var x in Archivio.Data.Seasons) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>@(PersonTypeForEntry == "PLAYER" ? "Numero maglia" : "Lettera dirigente")<input @bind="EntryNumber" placeholder="Numero / A-E" /></label>
                    <button class="archive-primary" @onclick="AddPersonEntry">ASSOCIA ALLA SQUADRA</button>
                </div>
                <div class="archive-list">
                    @foreach (var p in Archivio.Data.People.OrderBy(x => x.FullName))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">@(p.PersonType == "PLAYER" ? "👤" : "📋")</div><div class="archive-list-main"><strong>@p.FullName</strong><small>@(p.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @Archivio.Data.TeamEntries.Count(x => x.PersonId == p.Id) associazioni</small></div><span class="archive-status @(p.IsActive ? "on" : "off")">@(p.IsActive ? "ATTIVO" : "ARCHIVIATO")</span><button class="archive-small" @onclick="() => TogglePerson(p.Id)">@(p.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small danger" @onclick="() => DeletePerson(p.Id)">ELIMINA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "pdf")
        {
            <section class="archive-card import-card">
                <div class="archive-card-title"><div><h2>Importazione da referto ufficiale FIGH</h2><p>Carica un referto PDF, controlla i nominativi riconosciuti e scegli quali nuove anagrafiche aggiungere.</p></div><span class="archive-excel">PDF</span></div>
                <div class="archive-import-box">
                    <div class="archive-import-icon">⇧</div>
                    <div><strong>Seleziona il referto ufficiale FIGH</strong><p>È supportato il modello standard FIGH di una pagina. L'estrazione utilizza OCR: per la lettura è necessaria la connessione internet.</p>
                    <InputFile OnChange="ReadFighPdf" accept=".pdf,application/pdf" /></div>
                </div>
                @if (PdfReadBusy) { <div class="archive-message">Lettura del PDF e riconoscimento OCR in corso. Attendi il completamento…</div> }
                @if (!string.IsNullOrWhiteSpace(PdfImportMessage)) { <div class="archive-message">@PdfImportMessage</div> }
                @if (PdfPeople.Count > 0)
                {
                    <div class="archive-form-grid registration-form">
                        <label>Campionato<select @bind="PdfChampionshipId"><option value="">Seleziona campionato</option>@foreach (var x in Archivio.Data.Championships.OrderBy(x=>x.Name)) { <option value="@x.Id">@x.Name</option> }</select></label>
                        <label>Stagione<input @bind="PdfSeason" /></label>
                        <label>Squadra A<input @bind="PdfTeamA" /></label>
                        <label>Squadra B<input @bind="PdfTeamB" /></label>
                    </div>
                    <div class="archive-note"><strong>Controllo importazione</strong><p>Riconosciuti @PdfPeople.Count nominativi: @PdfPeople.Count(x=>x.Type=="PLAYER") atleti e @PdfPeople.Count(x=>x.Type=="OFFICIAL") dirigenti. I nominativi già presenti nell'anagrafica sono esclusi dall'inserimento; verifica e correggi eventuali errori OCR prima di confermare.</p>
                    <p><strong>Nuovi:</strong> @PdfPeople.Count(IsNewPdfPerson) nuove anagrafiche · <strong>Nuove iscrizioni:</strong> @PdfPeople.Count(IsNewPdfEntry) · <strong>Già iscritte:</strong> @PdfPeople.Count(x=>!IsNewPdfEntry(x))</p></div>
                    <div class="archive-list">
                        @foreach (var p in PdfPeople)
                        {
                            <div class="archive-list-row">
                                <input type="checkbox" @bind="p.Selected" disabled="@(!IsNewPdfEntry(p))" />
                                <div class="archive-list-main">
                                    <strong>@(p.Type=="PLAYER" ? "Atleta" : "Dirigente") · @p.Name</strong>
                                    <input @bind="p.Name" aria-label="Correggi nominativo" />
                                    @if (p.Type=="PLAYER") { <input @bind="p.Number" aria-label="Correggi numero maglia" placeholder="Numero maglia" /> }
                                    else { <input @bind="p.Letter" aria-label="Correggi lettera dirigente" placeholder="Lettera UFF" /> }
                                    <small>Squadra @(p.TeamIndex==0 ? "A" : "B") · @PdfEntryStatus(p)</small>
                                    @if (p.Type == "PLAYER" && PdfNameMatches(p).Count > 0)
                                    {
                                        <label>Persona da associare
                                            <select @bind="p.MatchedPersonId">
                                                <option value="">Seleziona anagrafica</option>
                                                @foreach (var match in PdfNameMatches(p))
                                                {
                                                    var oldTeams = PdfActiveRegistrations(p, match.Id).Select(e => Archivio.Data.Teams.FirstOrDefault(t=>t.Id==e.TeamId)?.Name).Where(n=>!string.IsNullOrWhiteSpace(n)).Distinct();
                                                    <option value="@match.Id">@match.FullName — @(oldTeams.Any() ? string.Join(", ", oldTeams) : "nessuna iscrizione attiva")</option>
                                                }
                                            </select>
                                        </label>
                                        <label>Risoluzione
                                            <select @bind="p.Resolution">
                                                <option value="">Da decidere</option>
                                                <option value="REUSE">È la stessa persona (riutilizza anagrafica)</option>
                                                <option value="TRANSFER">Trasferisci alla squadra del referto</option>
                                                <option value="NEW">È un omonimo (crea nuova anagrafica)</option>
                                                <option value="SKIP">È un doppione (non importare)</option>
                                            </select>
                                        </label>
                                        @if (PdfHasConflict(p))
                                        {
                                            <small>ATTENZIONE: l'atleta risulta già tesserato con un'altra squadra nella stessa stagione.</small>
                                        }
                                    }
                                </div>
                                <span class="archive-status @(IsNewPdfEntry(p) ? "on" : "off")">@(IsNewPdfEntry(p) ? "DA ISCRIVERE" : "PRESENTE")</span>
                            </div>
                        }
                    </div>
                    <div class="archive-form-grid">
                        <button class="archive-primary" @onclick="ConfirmPdfImport" disabled="@(string.IsNullOrWhiteSpace(PdfChampionshipId) || PdfPeople.All(x=>!x.Selected))">IMPORTA I NOMINATIVI SELEZIONATI</button>
                        <button class="archive-small" @onclick="ClearPdfImport">ANNULLA ANTEPRIMA</button>
                    </div>
                }
                <div class="archive-note"><strong>Protezione archivio</strong><p>La funzione aggiunge solo persone non presenti e le relative associazioni a squadra, campionato e stagione. Non modifica né cancella le anagrafiche esistenti. Il numero di maglia e la lettera UFF restano attributi dell'iscrizione.</p></div>
            </section>
        }
        else if (Tab == "importa")
        {
            <section class="archive-card import-card">
                <div class="archive-card-title"><div><h2>Importazione del modello Excel</h2><p>Importa gli elenchi già presenti nei tre fogli del file .xlsm, mantenendo le anagrafiche riutilizzabili.</p></div><span class="archive-excel">XLSM</span></div>
                <div class="archive-import-box"><div class="archive-import-icon">⇧</div><div><strong>Seleziona il modello Excel</strong><p>File supportati: .xlsm, .xlsx e .xls. Verranno letti i fogli «Squadre» e «Giocatori Dirigenti»; il foglio «Gara» viene usato per ricavare la stagione di riferimento.</p><InputFile OnChange="ImportExcel" accept=".xlsm,.xlsx,.xls" /></div></div>
                @if (!string.IsNullOrWhiteSpace(ImportMessage)) { <div class="archive-message">@ImportMessage</div> }
                <div class="archive-note"><strong>Come viene importato il modello</strong><ul><li>I campionati vengono creati dinamicamente in base ai nomi trovati nel foglio Squadre.</li><li>Le squadre vengono associate al rispettivo campionato.</li><li>Atleti e dirigenti vengono riconosciuti dai numeri di maglia e dalle lettere A–E.</li><li>Le anagrafiche già presenti vengono riutilizzate evitando duplicati.</li><li>La stagione viene letta dal foglio Gara; se manca, viene utilizzata 2026/2027.</li></ul></div>
            </section>
        }
        else
        {
            <section class="archive-card import-card">
                <div class="archive-card-title"><div><h2>Gestione e sicurezza archivio</h2><p>Esporta una copia, importa un archivio aggiornato oppure ripristina l'ultima copia di sicurezza.</p></div><span class="archive-count">JSON</span></div>
                <div class="archive-stats">
                    <div><b>@Archivio.Data.Championships.Count</b><span>Campionati</span></div>
                    <div><b>@Archivio.Data.Teams.Count</b><span>Squadre</span></div>
                    <div><b>@Archivio.Data.People.Count(x => x.PersonType == "PLAYER")</b><span>Atleti</span></div>
                    <div><b>@Archivio.Data.People.Count(x => x.PersonType == "OFFICIAL")</b><span>Dirigenti</span></div>
                </div>
                <div class="archive-note">
                    <strong>Sincronizzazione cloud privata</strong>
                    <p>Collega questo dispositivo al repository privato. Dopo aver scelto quale archivio utilizzare, le modifiche successive verranno salvate anche sul cloud. La copia locale continua a funzionare anche senza connessione.</p>
                    @if (!Cloud.IsAuthenticated)
                    {
                        <div class="operator-access-panel">
                            <h3>Accesso amministratore</h3>
                            <label>Password amministratore
                                <input type="password" @bind="CloudPassword" autocomplete="current-password" placeholder="Password amministratore" />
                            </label>
                            <button class="archive-primary" @onclick="ConnectCloud" disabled="@CloudBusy">ACCEDI COME AMMINISTRATORE</button>
                            <hr />
                            <h3>Attivazione operatore</h3>
                            <p>Inserisci il codice personale ricevuto dall'amministratore. Il dispositivo resterà autorizzato anche dopo la chiusura del browser.</p>
                            <label>Codice personale
                                <input @bind="OperatorCode" autocomplete="one-time-code" placeholder="Inserisci il tuo codice personale" />
                            </label>
                            <label>Nome dispositivo
                                <input @bind="DeviceName" placeholder="Es. Tablet segnapunti" />
                            </label>
                            <button class="archive-primary" @onclick="ActivateOperator" disabled="@CloudBusy">ATTIVA QUESTO DISPOSITIVO</button>
                        </div>
                    }
                    @if (Cloud.IsAuthenticated)
                    {
                        <p><strong>Utente collegato:</strong> @(Cloud.IsAdmin ? "Amministratore" : Cloud.OperatorName)</p>
                        <p><strong>Stato:</strong> @Cloud.Status</p>
                        @if (Cloud.HasPendingChanges)
                        {
                            <div class="archive-message">ATTENZIONE: ci sono modifiche locali non ancora presenti nel cloud. Non sostituire l archivio cloud. Le modifiche restano salvate su questo dispositivo.</div>
                            <button class="archive-primary" @onclick="RetryCloudSync" disabled="@CloudBusy">RIPROVA SINCRONIZZAZIONE</button>
                        }
                        @if (Cloud.IsAdmin)
                        {
                            <div class="operator-access-panel">
                                <h3>Gestione operatori</h3>
                                <div class="operator-create-row">
                                    <input @bind="NewOperatorName" placeholder="Nome e cognome dell'operatore" />
                                    <button class="archive-primary" @onclick="CreateOperator" disabled="@CloudBusy">CREA OPERATORE</button>
                                </div>
                                @if (CreatedOperatorCode is not null)
                                {
                                    <div class="operator-code-result">
                                        <strong>Codice personale da comunicare all'operatore</strong>
                                        <code>@CreatedOperatorCode</code>
                                        <button class="archive-small" @onclick="CopyOperatorCode">COPIA CODICE</button>
                                        <small>Conservalo: per sicurezza viene mostrato soltanto adesso.</small>
                                    </div>
                                }
                                @if (RotatedOperatorCode is not null)
                                {
                                    <div class="operator-code-result">
                                        <strong>Nuovo codice personale per @RotatedOperatorName</strong>
                                        <code>@RotatedOperatorCode</code>
                                        <button class="archive-small" @onclick="CopyRotatedOperatorCode">COPIA CODICE</button>
                                        <small>Il codice precedente non è più valido. I dispositivi già attivati restano autorizzati.</small>
                                    </div>
                                }
                                @if (Operators.Count > 0)
                                {
                                    <div class="operator-list">
                                        @foreach (var op in Operators)
                                        {
                                            <div class="operator-row">
                                                <div><strong>@op.Name</strong><small>@op.ActiveDeviceCount dispositivi attivi · @op.DeviceCount registrati</small></div>
                                                <span class="archive-status @(op.Active ? "on" : "off")">@(op.Active ? "ATTIVO" : "DISATTIVATO")</span>
                                                <button class="archive-small" @onclick="() => ToggleOperator(op)">@((op.Active) ? "DISATTIVA" : "RIATTIVA")</button>
                                                <button class="archive-small" @onclick="() => RotateOperatorCode(op)" disabled="@CloudBusy">RIGENERA CODICE</button>
                                                <button class="archive-small danger" @onclick="() => DeleteOperator(op)" disabled="@CloudBusy">ELIMINA DEFINITIVAMENTE</button>
                                            </div>
                                        }
                                    </div>
                                    @foreach (var op in Operators)
                                    {
                                        <div class="operator-device-block">
                                            <button class="archive-small" @onclick="() => ToggleDeviceList(op.Id)">@(ExpandedOperatorId == op.Id ? "NASCONDI DISPOSITIVI" : "GESTISCI DISPOSITIVI") · @op.Name</button>
                                            @if (ExpandedOperatorId == op.Id)
                                            {
                                                @if (OperatorDevices.Count == 0)
                                                {
                                                    <p class="operator-device-empty">Nessun dispositivo registrato.</p>
                                                }
                                                @foreach (var device in OperatorDevices)
                                                {
                                                    <div class="operator-device-row">

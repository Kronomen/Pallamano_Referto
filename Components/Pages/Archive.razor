    private async Task DeleteChampionship(string id)
    {
        var item = Archivio.Data.Championships.FirstOrDefault(x => x.Id == id);
        if (item is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Vuoi eliminare definitivamente il campionato {item.Name}? Saranno eliminate anche le relative associazioni dell'archivio. I referti già salvati non verranno modificati.")) return;
        Archivio.Data.TeamEntries.RemoveAll(e => e.ChampionshipId == id);
        Archivio.Data.Championships.Remove(item);
        await Archivio.SaveAsync();
        ImportMessage = $"Campionato «{item.Name}» eliminato.";

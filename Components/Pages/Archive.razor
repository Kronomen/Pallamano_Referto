                                                        @if (!device.IsRevoked)
                                                        {
                                                            <button class="archive-small danger" @onclick="() => RevokeOperatorDevice(device)">REVOCA</button>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>

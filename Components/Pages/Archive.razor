    protected override async Task OnInitializedAsync()
    {
        await Archivio.InitializeAsync();
        if (!Archivio.IsLoaded) return;
        await Cloud.TryRestoreSessionAsync();
        if (Cloud.IsAdmin) await LoadOperators();
        _syncMonitorCts = new CancellationTokenSource();
        _ = MonitorPendingSyncAsync(_syncMonitorCts.Token);
    }

    private async Task MonitorPendingSyncAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!Cloud.IsAuthenticated) continue;

                try
                {
                    if (Cloud.HasPendingChanges)
                    {
                        await Cloud.RetryPendingSyncAsync(Archivio.Data);
                    }
                    else
                    {
                        var update = await Cloud.CheckRemoteUpdateAsync();
                        if (update is not null)
                        {
                            var applied = await Archivio.ApplyRemoteUpdateAsync(update);
                            if (applied)
                                CloudMessage = "Nuove modifiche ricevute dal cloud e applicate automaticamente.";
                        }
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }
                catch (Exception ex)
                {
                    // Un errore temporaneo di rete o una risposta non valida non deve
                    // terminare definitivamente il monitor: il controllo riparte al tick successivo.
                    CloudMessage = "Controllo sincronizzazione non riuscito. Nuovo tentativo automatico tra 5 secondi. Dettaglio: " + ex.Message;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task RetryCloudSync()
    {
        CloudBusy = true;
        try { await Cloud.RetryPendingSyncAsync(Archivio.Data); CloudMessage = Cloud.Status; }
        finally { CloudBusy = false; StateHasChanged(); }
    }

    public ValueTask DisposeAsync()
    { _syncMonitorCts?.Cancel(); _syncMonitorCts?.Dispose(); return ValueTask.CompletedTask; }
    private bool IsLocalRunner => Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out var baseUri) && (baseUri.Host is "localhost" or "127.0.0.1") && baseUri.Port == 8088;
    private async Task CloseApplication()
    {
        if (CloudBusy) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Vuoi chiudere Referto Pallamano? Prima verranno completati i salvataggi e verificata la sincronizzazione delle modifiche in sospeso.");
        if (!confirmed) return;

        CloudBusy = true;
        try
        {
            // Salva sempre una copia aggiornata sul dispositivo prima di chiudere.
            await Archivio.SaveAsync();

            // Se esistono modifiche cloud in attesa, prova a sincronizzarle.
            // In caso di errore o conflitto non chiude: i dati restano disponibili
            // sul dispositivo e l'utente può riprovare la sincronizzazione.
            if (Cloud.HasPendingChanges)
                await Cloud.RetryPendingSyncAsync(Archivio.Data);

            if (Cloud.HasPendingChanges || Cloud.HasSyncConflict)
            {
                await JS.InvokeVoidAsync("alert", "Chiusura sospesa: alcune modifiche non sono ancora state sincronizzate con il cloud. I dati sono stati conservati su questo dispositivo. Risolvi la sincronizzazione e riprova.");
                return;
            }

            await JS.InvokeVoidAsync("closeProvaApp", IsLocalRunner);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Non è stato possibile completare il salvataggio. L'applicazione resta aperta. Dettaglio: " + ex.Message);
        }
        finally
        {
            CloudBusy = false;
        }
    }

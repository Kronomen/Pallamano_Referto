    private async Task SavePersonTeam()
    {
        if (SelectedPerson is null || string.IsNullOrWhiteSpace(SelectedPersonTeamId)) return;
        if (!Archivio.Data.Teams.Any(x => x.Id == SelectedPersonTeamId && x.IsActive)) return;
        var entries = Archivio.Data.TeamEntries.Where(x => x.PersonId == SelectedPerson.Id).ToList();
        if (entries.Any(x => x.TeamId != SelectedPersonTeamId))
        {
            var oldTeams = string.Join(", ", entries.Where(x => x.TeamId != SelectedPersonTeamId)

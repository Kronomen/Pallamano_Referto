@page "/archivio"
@implements IAsyncDisposable
@using System.Text.Json
@using RefertoPallamano_Blazor.Services
@inject ArchiveService Archivio
@inject CloudArchiveService Cloud
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Archivio - Referto Pallamano</PageTitle>

<div class="archive-app">
    <header class="archive-header">
        <div class="archive-brand"><img src="images/FIGH.png" alt="FIGH" /><div><strong>REFERTO PALLAMANO</strong><span>GESTIONE ARCHIVIO</span></div></div>
        <div class="archive-header-actions">@if (Cloud.IsAuthenticated) { <button type="button" @onclick="DisconnectCloud" style="border:2px solid #dc2626;border-radius:8px;background:#dc2626;color:#173b70;padding:10px 14px;font-weight:900;cursor:pointer;">@(Cloud.IsAdmin ? "ESCI DA AMMINISTRATORE" : "ESCI DA OPERATORE")</button> } <button class="archive-back" @onclick="BackToMatch">← TORNA ALLA GARA</button></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Archivio.LoadError))
    {
        <section class="archive-card import-card">
            <h1>Archivio locale non caricato</h1>
            <p>@Archivio.LoadError</p>
            <p><strong>Non cancellare i dati del browser e non reinstallare l'applicazione.</strong> Puoi tentare di esportare il contenuto locale originale prima di qualsiasi ripristino.</p>
            <button class="archive-primary" @onclick="ExportStoredArchive">ESPORTA CONTENUTO LOCALE PER RECUPERO</button>
            <button class="archive-small" @onclick="RetryArchiveLoad">RIPROVA CARICAMENTO</button>
        </section>
    }
    else if (!Archivio.IsLoaded)
    {
        <div class="archive-loading">Caricamento archivio…</div>
    }
    else
    {
        <section class="archive-intro">
            <div><span class="archive-eyebrow">MODULO GESTIONALE</span><h1>CAMPIONATI, SQUADRE E ATLETI</h1><p>Gestisci gli archivi in modo dinamico: puoi aggiungere campionati e squadre senza modificare il programma.</p></div>
            <div class="archive-stats"><div><b>@Archivio.Data.Championships.Count</b><span>Campionati</span></div><div><b>@Archivio.Data.Teams.Count</b><span>Squadre</span></div><div><b>@Archivio.Data.People.Count</b><span>Persone</span></div></div>
        </section>

        <nav class="archive-tabs">
            <button class="@(Tab == "campionati" ? "active" : "")" @onclick='() => SetTab("campionati")'>CAMPIONATI</button>
            <button class="@(Tab == "squadre" ? "active" : "")" @onclick='() => SetTab("squadre")'>SQUADRE</button>
            <button class="@(Tab == "stagioni" ? "active" : "")" @onclick='() => SetTab("stagioni")'>STAGIONI</button>
            <button class="@(Tab == "persone" ? "active" : "")" @onclick='() => SetTab("persone")'>ATLETI E DIRIGENTI</button>
            <button class="@(Tab == "importa" ? "active" : "")" @onclick='() => SetTab("importa")'>IMPORTA EXCEL</button>
            <button class="@(Tab == "gestione" ? "active" : "")" @onclick='() => SetTab("gestione")'>GESTIONE ARCHIVIO</button>
            <button type="button" class="archive-close-tab" @onclick="CloseApplication" disabled="@CloudBusy">CHIUDI APPLICAZIONE</button>
        </nav>

        @if (Tab == "campionati")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Elenco campionati</h2><p>I campionati sono dati configurabili, non opzioni fisse del programma.</p></div><span class="archive-count">@Archivio.Data.Championships.Count</span></div>
                <div class="archive-form-grid championship-form">
                    <label>Nome campionato
                        <input @bind="ChampionshipName" placeholder="Es. Serie A1 Femminile" />
                    </label>
                    <label>Categoria
                        <select @bind="ChampionshipCategory">
                            <option value="">Seleziona categoria</option>
                            <option value="Senior">Senior</option>
                            <option value="Junior">Junior</option>
                            <option value="Open">Open</option>
                        </select>
                    </label>
                    <label>Genere
                        <select @bind="ChampionshipGender">
                            <option value="">Non specificato</option>
                            <option>Femminile</option>
                            <option>Maschile</option>
                            <option>Misto</option>
                        </select>
                    </label>
                    <button class="archive-primary" @onclick="AddChampionship" disabled="@string.IsNullOrWhiteSpace(ChampionshipName)">+ AGGIUNGI CAMPIONATO</button>
                </div>
                @if (Archivio.Data.Championships.Count == 0) { <div class="archive-empty">Nessun campionato inserito. Puoi crearne uno qui sopra o importare il modello Excel.</div> }
                <div class="archive-list championship-grid">
                    @foreach (var c in Archivio.Data.Championships.OrderBy(x => x.Name))
                    {
                        <div class="archive-list-row championship-row"><div class="archive-list-icon">🏆</div><div class="archive-list-main"><strong>@c.Name</strong><small>@(string.IsNullOrWhiteSpace(c.Category) ? "Categoria non specificata" : c.Category) · @(string.IsNullOrWhiteSpace(c.Gender) ? "Genere non specificato" : c.Gender)</small></div><span class="archive-status @(c.IsActive ? "on" : "off")">@(c.IsActive ? "ATTIVO" : "ARCHIVIATO")</span><button class="archive-small" @onclick="() => ToggleChampionship(c.Id)">@(c.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small danger" @onclick="() => DeleteChampionship(c.Id)">ELIMINA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "squadre")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Squadre</h2><p>Una squadra può essere iscritta a campionati e stagioni differenti.</p></div><span class="archive-count">@Archivio.Data.Teams.Count</span></div>
                <div class="archive-form-grid">
                    <label>Denominazione squadra<input @bind="TeamName" placeholder="Nome squadra" /></label>
                    <label>Nome abbreviato<input @bind="TeamShortName" placeholder="Facoltativo" /></label>
                    <button class="archive-primary" @onclick="AddTeam">+ AGGIUNGI SQUADRA</button>
                </div>
                <div class="archive-form-grid registration-form">
                    <label>Squadra<select @bind="TeamRegistrationTeamId"><option value="">Seleziona squadra</option>@foreach (var x in Archivio.Data.Teams) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Campionato<select @bind="TeamRegistrationChampionshipId"><option value="">Seleziona campionato</option>@foreach (var x in Archivio.Data.Championships) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <label>Stagione<select @bind="TeamRegistrationSeasonId"><option value="">Seleziona stagione</option>@foreach (var x in Archivio.Data.Seasons) { <option value="@x.Id">@x.Name</option> }</select></label>
                    <button class="archive-primary" @onclick="AddTeamRegistration">ISCRIVI SQUADRA</button>
                </div>
                <div class="archive-list teams-grid">
                    @foreach (var t in Archivio.Data.Teams.OrderBy(x => x.Name))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">🏐</div><div class="archive-list-main"><strong>@t.Name</strong><small>@(string.IsNullOrWhiteSpace(t.ShortName) ? "Nessuna abbreviazione" : t.ShortName) · @Archivio.Data.TeamEntries.Count(x => x.TeamId == t.Id && x.EntryType == "TEAM") iscrizioni</small></div><span class="archive-status @(t.IsActive ? "on" : "off")">@(t.IsActive ? "ATTIVA" : "ARCHIVIATA")</span><button class="archive-small" @onclick="() => ToggleTeam(t.Id)">@(t.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small archive-delete-team" @onclick="() => DeleteTeam(t.Id)">CANCELLA</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "stagioni")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Stagioni sportive</h2><p>Ogni iscrizione e ogni rosa sono collegate a una stagione specifica.</p></div><span class="archive-count">@Archivio.Data.Seasons.Count</span></div>
                <div class="archive-form-grid season-form">
                    <label>Nome stagione<input @bind="SeasonName" placeholder="Es. 2027/2028" /></label>
                    <label>Data inizio<input type="date" @bind="SeasonStart" /></label>
                    <label>Data fine<input type="date" @bind="SeasonEnd" /></label>
                    <button class="archive-primary" @onclick="AddSeason">+ AGGIUNGI STAGIONE</button>
                </div>
                <div class="archive-list">
                    @foreach (var season in Archivio.Data.Seasons.OrderByDescending(x => x.Name))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">📅</div><div class="archive-list-main"><strong>@season.Name</strong><small>@season.StartDate.ToString("dd/MM/yyyy") – @season.EndDate.ToString("dd/MM/yyyy") · @Archivio.Data.TeamEntries.Count(x => x.SeasonId == season.Id) associazioni</small></div><span class="archive-status @(season.IsActive ? "on" : "off")">@(season.IsActive ? "ATTIVA" : "ARCHIVIATA")</span><button class="archive-small" @onclick="() => ToggleSeason(season.Id)">@(season.IsActive ? "ARCHIVIA" : "RIATTIVA")</button></div>
                    }
                </div>
            </section>
        }
        else if (Tab == "persone")
        {
            <section class="archive-card">
                <div class="archive-card-title"><div><h2>Anagrafica atleti e dirigenti</h2><p>Il numero di maglia e la lettera del dirigente appartengono all'iscrizione stagionale, non alla persona.</p></div><span class="archive-count">@Archivio.Data.People.Count</span></div>
                <div class="archive-form-grid people-form">
                    <label>Nominativo<input @bind="PersonName" placeholder="Cognome e nome" /></label>
                    <label>Tipo<select @bind="PersonType"><option value="PLAYER">Atleta</option><option value="OFFICIAL">Dirigente</option></select></label>
                    <button class="archive-primary" @onclick="AddPerson">+ AGGIUNGI PERSONA</button>
                </div>
                @if (DuplicatePlayerEnrollments.Count > 0)
                {
                    <div class="archive-message">
                        <strong>Rilevate @DuplicatePlayerEnrollments.Count situazioni con più società attive per lo stesso atleta nella stessa stagione.</strong>
                        <p>Verrà mantenuta la prima società registrata; le iscrizioni alle altre società saranno disattivate, senza cancellare lo storico o modificare i referti già salvati.</p>
                        @foreach (var duplicate in DuplicatePlayerEnrollments)
                        {
                            <div class="archive-list-row">
                                <div class="archive-list-main">
                                    <strong>@duplicate.PersonName</strong>
                                    <small>@duplicate.SeasonName · Mantieni: @duplicate.KeepTeamName · Disattiva: @string.Join(", ", duplicate.RemoveTeamNames)</small>
                                </div>
                            </div>
                        }
                        <button class="archive-primary" @onclick="DeactivateDuplicatePlayerEnrollments">DISATTIVA LE SECONDE SOCIETÀ</button>
                    </div>
                }
                @if (DuplicatePeople.Count > 0)
                {
                    <div class="archive-message">
                        <strong>Attenzione: nominativo già presente in archivio.</strong>
                        <p>Seleziona la persona esistente per modificarne la squadra oppure indica che si tratta di un omonimo per creare una nuova scheda.</p>
                        @foreach (var duplicate in DuplicatePeople)
                        {
                            <div class="archive-list-row">
                                <div class="archive-list-main"><strong>@duplicate.FullName</strong><small>@(duplicate.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @Archivio.Data.TeamEntries.Where(x => x.PersonId == duplicate.Id && x.IsActive).Select(x => Archivio.Data.Teams.FirstOrDefault(t => t.Id == x.TeamId)?.Name).Where(x => x != null).Distinct().DefaultIfEmpty("Nessuna squadra attiva").Aggregate((a, b) => a + ", " + b)</small></div>
                                <button class="archive-primary" @onclick="() => UseExistingPerson(duplicate.Id)">È LA STESSA PERSONA</button>
                            </div>
                        }
                        <button class="archive-small" @onclick="AddHomonym">È UN OMONIMO: CREA NUOVA SCHEDA</button>
                        <button class="archive-small" @onclick="CancelDuplicatePerson">ANNULLA</button>
                    </div>
                }
                <section class="archive-note">
                    <h3>Ricerca Atleta/Dirigente</h3>
                    <div class="archive-form-grid">
                        <label>Ricerca per cognome
                            <input @bind="PersonSearchSurname" @bind:event="oninput" placeholder="Inserisci il cognome" />
                        </label>
                        <button type="button" class="archive-small" @onclick="() => PersonSearchSurname = string.Empty">NUOVA RICERCA</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(PersonSearchSurname))
                    {
                        var foundBySurname = PeopleFoundBySurname;
                        <p class="archive-note">Risultati per “@PersonSearchSurname”: @foundBySurname.Count</p>
                        @if (foundBySurname.Count == 0)
                        {
                            <div class="archive-empty">Nessuna persona trovata con questo cognome.</div>
                        }
                        else
                        {
                            <div class="archive-list">
                                @foreach (var person in foundBySurname)
                                {
                                    <div class="archive-list-row">
                                        <div class="archive-list-icon">@(person.PersonType == "PLAYER" ? "👤" : "📋")</div>
                                        <div class="archive-list-main">
                                            <button type="button" class="archive-person-name" @onclick="() => OpenPersonAssociations(person.Id)">@person.FullName</button>
                                            <small>@(person.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @GetPersonTeamNames(person.Id)</small>
                                        </div>
                                        <span class="archive-status @(person.IsActive ? "on" : "off")">@(person.IsActive ? "ATTIVO" : "ARCHIVIATO")</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </section>
                <section class="archive-note">
                    <h3>Ricerca per squadra</h3>
                    <label>Squadra
                        <select @bind="PersonSearchTeamId">
                            <option value="">Seleziona società</option>
                            @foreach (var team in Archivio.Data.Teams.Where(x => x.IsActive).OrderBy(x => x.Name))
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        </select>
                    </label>
                    @if (!string.IsNullOrWhiteSpace(PersonSearchTeamId))
                    {
                        <p class="archive-note">Persone associate: @PeopleFoundByTeam.Count</p>
                        @if (PeopleFoundByTeam.Count == 0)
                        {
                            <div class="archive-empty">Nessun atleta o dirigente associato a questa società.</div>
                        }
                        else
                        {
                            <div class="archive-list">
                                @foreach (var person in PeopleFoundByTeam)
                                {
                                    <div class="archive-list-row">
                                        <div class="archive-list-icon">@(person.PersonType == "PLAYER" ? "👤" : "📋")</div>
                                        <div class="archive-list-main">
                                            <button type="button" class="archive-person-name" @onclick="() => OpenPersonAssociations(person.Id)">@person.FullName</button>
                                            <small>@(person.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @GetTeamEntryDetails(person.Id, PersonSearchTeamId)</small>
                                        </div>
                                        <span class="archive-status @(person.IsActive ? "on" : "off")">@(person.IsActive ? "ATTIVO" : "ARCHIVIATO")</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </section>
                <div class="archive-list">
                    @foreach (var p in Archivio.Data.People.OrderBy(x => x.FullName))
                    {
                        <div class="archive-list-row"><div class="archive-list-icon">@(p.PersonType == "PLAYER" ? "👤" : "📋")</div><div class="archive-list-main"><button type="button" class="archive-person-name" @onclick="() => OpenPersonAssociations(p.Id)">@p.FullName</button><small>@(p.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @Archivio.Data.TeamEntries.Count(x => x.PersonId == p.Id && x.IsActive) iscrizioni attive</small></div><span class="archive-status @(p.IsActive ? "on" : "off")">@(p.IsActive ? "ATTIVO" : "ARCHIVIATO")</span><button class="archive-small" @onclick="() => TogglePerson(p.Id)">@(p.IsActive ? "ARCHIVIA" : "RIATTIVA")</button><button class="archive-small archive-delete-team" @onclick="() => DeletePerson(p.Id)">CANCELLA</button></div>
                    }
                </div>
                @if (SelectedPerson is not null)
                {
                    <div class="archive-person-modal-backdrop">
                        <section class="archive-person-modal" role="dialog" aria-modal="true" aria-labelledby="person-associations-title">
                            <div class="archive-card-title"><div><h2 id="person-associations-title">@SelectedPerson.FullName</h2><p>Seleziona la società di appartenenza attuale. Ogni persona può essere assegnata a una sola squadra.</p></div><button class="archive-small" @onclick="ClosePersonAssociations">CHIUDI</button></div>
                            <div class="archive-form-grid">
                                <label>Società di appartenenza
                                    <select @bind="SelectedPersonTeamId">
                                        <option value="">Seleziona squadra</option>
                                        @foreach (var team in Archivio.Data.Teams.Where(x => x.IsActive).OrderBy(x => x.Name))
                                        {
                                            <option value="@team.Id">@team.Name</option>
                                        }
                                    </select>
                                </label>
                                <button class="archive-primary" @onclick="SavePersonTeam" disabled="@string.IsNullOrWhiteSpace(SelectedPersonTeamId)">SALVA SOCIETÀ</button>
                            </div>
                            @if (SelectedPersonEntries.Count > 0)
                            {
                                <p class="archive-note">Elenco completo delle iscrizioni. Se un atleta risulta attivo in più società nella stessa stagione, la funzione di pulizia mantiene automaticamente la prima società registrata e disattiva le successive. Per correggere la società, utilizza il selettore qui sopra.</p>
                                <div class="archive-list">
                                    @foreach (var entry in SelectedPersonEntries)
                                    {
                                        var teamName = Archivio.Data.Teams.FirstOrDefault(x => x.Id == entry.TeamId)?.Name ?? "Squadra non trovata";
                                        var championshipName = Archivio.Data.Championships.FirstOrDefault(x => x.Id == entry.ChampionshipId)?.Name ?? "Campionato non trovato";
                                        var seasonName = Archivio.Data.Seasons.FirstOrDefault(x => x.Id == entry.SeasonId)?.Name ?? "Stagione non trovata";
                                        <div class="archive-list-row">
                                            <div class="archive-list-main"><strong>@teamName</strong><small>@championshipName · @seasonName · @(entry.EntryType == "PLAYER" ? "Atleta" : "Dirigente") · @(entry.EntryType == "PLAYER" ? "N. " + entry.ShirtNumber : "Lettera " + entry.OfficialLetter)</small></div>
                                            <span class="archive-status @(entry.IsActive ? "on" : "off")">@(entry.IsActive ? "ATTIVA" : "DISATTIVATA")</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="archive-empty">Questa persona non ha ancora un'iscrizione a un campionato e a una stagione. Dopo aver scelto la società, potrai inserirla dal modulo di associazione.</div>
                            }
                        </section>
                    </div>
                }
            </section>
        }
        else if (Tab == "importa")
        {
            <section class="archive-card import-card">
                <div class="archive-card-title"><div><h2>Importa atleti/dirigenti da PDF</h2><p>Carica il referto completo di una gara precedente: verranno lette soltanto le due tabelle delle rose, ignorando risultati, marcatori e ufficiali di gara.</p></div><span class="archive-excel">PDF</span></div>
                <div class="archive-import-box"><div class="archive-import-icon">⇧</div><div><strong>Seleziona il referto PDF</strong><p>PDF FIGH in formato A4. L'estrazione utilizza OCR sulle sole aree delle rose; i nominativi saranno modificabili prima del salvataggio.</p><InputFile OnChange="ImportPdfRoster" accept=".pdf,application/pdf" /></div></div>
                @if (PdfBusy) { <div class="archive-message">Lettura del PDF in corso. Il riconoscimento OCR può richiedere qualche secondo…</div> }
                @if (!string.IsNullOrWhiteSpace(ImportMessage)) { <div class="archive-message">@ImportMessage</div> }
                @if (PdfRoster is not null)
                {
                    <div class="archive-note">
                        <strong>Verifica i dati prima dell'importazione</strong>
                        <div class="archive-form-grid">
                            <label>Campionato
                                <select @bind="PdfChampionship">
                                    <option value="">Seleziona campionato</option>
                                    @foreach (var c in Archivio.Data.Championships.OrderBy(x => x.Name)) { <option value="@c.Name">@c.Name</option> }
                                </select>
                            </label>
                            <label>Stagione
                                <select @bind="PdfSeason">
                                    <option value="">Seleziona stagione</option>
                                    @foreach (var season in Archivio.Data.Seasons.OrderByDescending(x => x.StartDate)) { <option value="@season.Name">@season.Name</option> }
                                </select>
                            </label>
                        </div>
                    </div>
                    @foreach (var team in PdfRoster.Teams)
                    {
                        <div class="archive-note">
                            <h3>Squadra rilevata: @team.DetectedName</h3>
                            <label>Associa alla società presente in archivio
                                <select @bind="team.TeamId">
                                    <option value="">Seleziona società</option>
                                    @foreach (var t in Archivio.Data.Teams.OrderBy(x => x.Name)) { <option value="@t.Id">@t.Name</option> }
                                </select>
                            </label>
                            <div class="archive-list">
                                @foreach (var person in team.People)
                                {
                                    <div class="archive-list-row">
                                        <input type="checkbox" @bind="person.Selected" />
                                        <div class="archive-list-main">
                                            <input class="archive-inline-edit" @bind="person.NumberOrLetter" aria-label="Numero maglia o lettera" />
                                            <input class="archive-inline-edit" @bind="person.Name" aria-label="Cognome e nome" />
                                            <small>@(person.PersonType == "PLAYER" ? "Atleta" : "Dirigente") · @GetPdfPersonStatus(person, team.TeamId, PdfChampionship, PdfSeason)</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <button class="archive-primary" disabled="@(!CanImportPdfRoster)" @onclick="ConfirmPdfRosterImport">CONFERMA E IMPORTA LE PERSONE SELEZIONATE</button>
                    <button class="archive-small" @onclick="CancelPdfRoster">ANNULLA ANTEPRIMA</button>
                }
                <div class="archive-note"><strong>Regole di importazione</strong><ul><li>Vengono considerate esclusivamente le rose delle due squadre: giocatori numerati e dirigenti UFF.A–UFF.E.</li><li>Le anagrafiche già presenti vengono riutilizzate, senza creare duplicati.</li><li>Se l'iscrizione esiste ma manca il numero o la lettera, viene completata.</li><li>Se la persona risulta già attiva in un'altra società per lo stesso campionato e stagione, non viene spostata automaticamente: viene segnalata come da verificare.</li><li>Il salvataggio avviene solo dopo la verifica e la conferma.</li></ul></div>
            </section>
        }
        else
        {
            <section class="archive-card import-card">
                <div class="archive-card-title"><div><h2>Gestione e sicurezza archivio</h2><p>Esporta una copia, importa un archivio aggiornato oppure ripristina l'ultima copia di sicurezza.</p></div><span class="archive-count">JSON</span></div>
                <div class="archive-stats">
                    <div><b>@Archivio.Data.Championships.Count</b><span>Campionati</span></div>
                    <div><b>@Archivio.Data.Teams.Count</b><span>Squadre</span></div>
                    <div><b>@Archivio.Data.People.Count(x => x.PersonType == "PLAYER")</b><span>Atleti</span></div>
                    <div><b>@Archivio.Data.People.Count(x => x.PersonType == "OFFICIAL")</b><span>Dirigenti</span></div>
                </div>
                <div class="archive-note">
                    <strong>Sincronizzazione cloud privata</strong>
                    <p>Collega questo dispositivo al repository privato. Dopo aver scelto quale archivio utilizzare, le modifiche successive verranno salvate anche sul cloud. La copia locale continua a funzionare anche senza connessione.</p>
                    @if (!Cloud.IsAuthenticated)
                    {
                        <div class="operator-access-panel">
                            <h3>Accesso amministratore</h3>
                            <label>Password amministratore
                                <input type="password" @bind="CloudPassword" autocomplete="current-password" placeholder="Password amministratore" />

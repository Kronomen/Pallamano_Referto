        if (person is null) return;
        var associations = Archivio.Data.TeamEntries.Where(e => e.PersonId == id).ToList();
        var message = associations.Count == 0
            ? $"Vuoi cancellare definitivamente {person.FullName}? L'operazione non può essere annullata."
            : $"Vuoi cancellare definitivamente {person.FullName}? Verranno eliminate anche le {associations.Count} associazioni con squadre, campionati e stagioni presenti nell'archivio. I referti già salvati non vengono modificati.";
        if (!await JS.InvokeAsync<bool>("confirm", message)) return;
        Archivio.Data.TeamEntries.RemoveAll(e => e.PersonId == id);
        Archivio.Data.People.Remove(person);
        await Archivio.SaveAsync();
    }

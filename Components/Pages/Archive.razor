            await LoadOperators();
        }
        catch (Exception ex) { CloudMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task ActivateOperator()
    {
        CloudBusy = true; CloudMessage = "";
        try
        {
            await Cloud.ActivateOperatorAsync(OperatorCode, DeviceName);
            OperatorCode = "";
            CloudMessage = Cloud.Status;
        }
        catch (Exception ex) { CloudMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task LoadOperators()
    {
        try { Operators = await Cloud.GetOperatorsAsync(); OperatorMessage = "Elenco aggiornato."; }
        catch (Exception ex) { OperatorMessage = ex.Message; }
    }

    private async Task ToggleDeviceList(string operatorId)
    {
        if (ExpandedOperatorId == operatorId) { ExpandedOperatorId = null; OperatorDevices.Clear(); return; }
        ExpandedOperatorId = operatorId;
        await LoadOperatorDevices(operatorId);
    }

    private async Task LoadOperatorDevices(string operatorId)
    {
        try { OperatorDevices = await Cloud.GetOperatorDevicesAsync(operatorId); }
        catch (Exception ex) { OperatorMessage = ex.Message; }
    }

    private async Task RevokeOperatorDevice(OperatorDeviceInfo device)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Vuoi revocare l'accesso del dispositivo {device.DeviceName}? L'app su quel dispositivo non potrà più sincronizzarsi.")) return;
        CloudBusy = true;
        try
        {
            await Cloud.RevokeDeviceAsync(device.Id);
            if (ExpandedOperatorId is not null) await LoadOperatorDevices(ExpandedOperatorId);
            await LoadOperators();
            OperatorMessage = "Dispositivo revocato.";
        }
        catch (Exception ex) { OperatorMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task CreateOperator()
    {
        if (string.IsNullOrWhiteSpace(NewOperatorName)) { OperatorMessage = "Inserisci il nominativo dell'operatore."; return; }
        CloudBusy = true; OperatorMessage = ""; CreatedOperatorCode = null;
        try
        {
            var created = await Cloud.CreateOperatorAsync(NewOperatorName);
            NewOperatorName = "";
            CreatedOperatorCode = created.Code;
            await LoadOperators();
            OperatorMessage = "Operatore creato. Copia e comunica il codice personale.";
        }
        catch (Exception ex) { OperatorMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task RotateOperatorCode(OperatorInfo op)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Vuoi rigenerare il codice personale di {op.Name}? Il codice precedente non sarà più valido. I dispositivi già attivati continueranno a funzionare.")) return;
        CloudBusy = true;
        OperatorMessage = "";
        RotatedOperatorCode = null;
        try
        {
            RotatedOperatorCode = await Cloud.RotateOperatorCodeAsync(op.Id);
            RotatedOperatorName = op.Name;
            OperatorMessage = "Nuovo codice generato. Copialo e comunicalo all'operatore.";
        }
        catch (Exception ex) { OperatorMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task CopyRotatedOperatorCode()
    {
        if (RotatedOperatorCode is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", RotatedOperatorCode);
    }

    private async Task ToggleOperator(OperatorInfo op)
    {
        var next = !op.Active;
        if (!await JS.InvokeAsync<bool>("confirm", $"Vuoi {(next ? "riattivare" : "disattivare")} l'operatore {op.Name}?")) return;
        CloudBusy = true;
        try { await Cloud.SetOperatorActiveAsync(op.Id, next); await LoadOperators(); }
        catch (Exception ex) { OperatorMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task DeleteOperator(OperatorInfo op)
    {
        var warning = $"ATTENZIONE: stai per eliminare DEFINITIVAMENTE l'operatore {op.Name} e tutti i suoi {op.DeviceCount} dispositivi registrati. L'operazione è irreversibile e tutti i relativi accessi saranno revocati. Referti e archivio gare non verranno modificati.\n\nPer una sospensione temporanea usa DISATTIVA. Vuoi continuare?";
        if (!await JS.InvokeAsync<bool>("confirm", warning)) return;

        var typedName = await JS.InvokeAsync<string?>("prompt", $"Per confermare, digita esattamente il nominativo dell'operatore:\n{op.Name}");
        if (!string.Equals(typedName?.Trim(), op.Name, StringComparison.Ordinal))
        {
            OperatorMessage = "Cancellazione annullata: il nominativo non corrisponde.";
            return;
        }

        CloudBusy = true;
        OperatorMessage = "";
        try
        {
            await Cloud.DeleteOperatorAsync(op.Id);
            if (ExpandedOperatorId == op.Id)
            {
                ExpandedOperatorId = null;
                OperatorDevices.Clear();
            }
            if (string.Equals(RotatedOperatorName, op.Name, StringComparison.Ordinal))
            {
                RotatedOperatorCode = null;
                RotatedOperatorName = "";
            }
            await LoadOperators();
            OperatorMessage = $"Operatore {op.Name} e relativi dispositivi eliminati definitivamente.";
        }
        catch (Exception ex) { OperatorMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task CopyOperatorCode()
    {
        if (CreatedOperatorCode is not null) await JS.InvokeVoidAsync("navigator.clipboard.writeText", CreatedOperatorCode);
    }

    private async Task DisconnectCloud()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "pallamanoCloudApiToken");
        Nav.NavigateTo("/archivio", forceLoad: true);
    }

    private async Task UploadLocalArchive()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Vuoi caricare nel cloud l'archivio attualmente presente su questo dispositivo? Questa sarà la copia iniziale condivisa con gli altri dispositivi.")) return;
        CloudBusy = true; CloudMessage = "";
        try
        {
            await Cloud.UploadInitialAsync(Archivio.Data);
            CloudMessage = Cloud.Status;
        }
        catch (Exception ex) { CloudMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task DownloadCloudArchive()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "L'archivio locale verrà prima salvato in un backup e poi sostituito con quello presente nel cloud. Vuoi continuare?")) return;
        CloudBusy = true; CloudMessage = "";
        try
        {
            var remote = await Cloud.DownloadRemoteAsync();
            if (remote is null) { CloudMessage = "Nel cloud non è presente alcun archivio."; return; }
            await Archivio.ReplaceFromJsonAsync(JsonSerializer.Serialize(remote), syncCloud: false);
            await Cloud.EnableAutoSyncAsync();
            CloudMessage = "Archivio cloud copiato su questo dispositivo. Sincronizzazione automatica attiva.";
        }
        catch (Exception ex) { CloudMessage = ex.Message; }
        finally { CloudBusy = false; }
    }

    private async Task ExportBackup()
    {
        var json = await Archivio.ExportJsonAsync();
        await JS.InvokeVoidAsync("refertoDownload", $"Archivio_RefertoPallamano_{DateTime.Now:yyyyMMdd_HHmm}.json", json);
        ImportMessage = "Esportazione completata.";
    }

    private async Task ImportArchiveJson(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            if (!await JS.InvokeAsync<bool>("confirm", "L'archivio attuale verrà salvato in un backup e poi sostituito. Vuoi continuare?")) return;
            await Archivio.ReplaceFromJsonAsync(json);
            ImportMessage = "Archivio importato correttamente. La versione precedente è stata salvata nel backup.";
        }
        catch (Exception ex) { ImportMessage = "Importazione non completata: " + ex.Message; }
    }

    private async Task RestoreBackup()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Vuoi sostituire l'archivio attuale con l'ultima copia di sicurezza?")) return;
        try
        {
            var restored = await Archivio.RestoreBackupAsync();
            ImportMessage = restored ? "Backup ripristinato correttamente." : "Non è disponibile alcun backup.";
        }
        catch (Exception ex) { ImportMessage = "Ripristino non completato: " + ex.Message; }
    }

    private async Task ExportStoredArchive()
    {
        try
        {
            var raw = await Archivio.ExportStoredArchiveRawAsync();
            if (string.IsNullOrWhiteSpace(raw))
            {
                CloudMessage = "Non è stato trovato un contenuto locale da esportare.";
                return;
            }
            await JS.InvokeVoidAsync("refertoDownload", $"Archivio_Locale_Recupero_{DateTime.Now:yyyyMMdd_HHmm}.json", raw);
            CloudMessage = "Contenuto locale originale esportato. Conservalo senza modificarlo.";
        }
        catch (Exception ex) { CloudMessage = "Esportazione del contenuto locale non riuscita: " + ex.Message; }
    }

    private void RetryArchiveLoad() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}
